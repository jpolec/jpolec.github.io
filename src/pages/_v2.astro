---
import SimpleLayout from '../layouts/SimpleLayout.astro';
import { profile } from '../data/profile';

const productProof = [
  {
    name: 'OneBook',
    summary: 'Research, portfolio, risk and execution context in one workspace.',
    href: 'https://onebook.quantjourney.cloud/',
  },
  {
    name: 'Quant API / MCP',
    summary: 'Financial data for applications, research and approved AI clients.',
    href: 'https://api.quantjourney.cloud/',
  },
  {
    name: 'Quant DataLake',
    summary: 'Market, fundamental and portfolio data for analytical workflows.',
    href: 'https://data.quantjourney.cloud/',
  },
  {
    name: 'Backtester',
    summary: 'Reproducible strategy research, diagnostics and backtest results.',
    href: 'https://backtester.quantjourney.cloud/',
  },
  {
    name: 'Agents',
    summary: 'AI tools with scoped access and responses grounded in evidence.',
    href: 'https://agents.quantjourney.cloud/',
  },
];

---

<SimpleLayout
  title="Jakub Połeć | Quant Systems Architect & Founder of QuantJourney"
  description={profile.description}
  canonical="https://jakubpolec.com/_v2/"
  noindex={true}
>
  <main class="v2-page-shell">
    <section class="v2-hero" aria-labelledby="v2-title">
      <h1 id="v2-title">{profile.name}</h1>
      <p class="v2-role">{profile.role}</p>
      <p class="v2-hero-copy">
        I design and build quantitative research and investment systems for funds,
        family offices and investment-technology teams.
      </p>
      <p class="v2-hero-copy">
        My work connects data pipelines, backtesting, portfolio and risk analytics, and AI tooling -
        from research design to implementation and validation.
      </p>
      <div class="v2-contact-row" aria-label="Contact links">
        <a class="v2-button" href={profile.urls.email}>Email me <span aria-hidden="true">↗</span></a>
        <a
          class="v2-social-link"
          href="https://linkedin.com/in/jakubpolec"
          target="_blank"
          rel="noopener"
          aria-label="LinkedIn profile"
          title="LinkedIn"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M6.94 8.5A1.72 1.72 0 1 0 6.94 5.06a1.72 1.72 0 0 0 0 3.44ZM5.48 18.94h2.93V10H5.48v8.94ZM10.25 10v8.94h2.92v-4.42c0-1.17.22-2.3 1.67-2.3 1.43 0 1.45 1.34 1.45 2.38v4.34h2.93v-4.93c0-2.42-.52-4.28-3.35-4.28-1.36 0-2.27.74-2.64 1.45h-.04V10h-2.94Z" />
          </svg>
        </a>
        <a
          class="v2-social-link"
          href="https://x.com/jakubpolec"
          target="_blank"
          rel="noopener"
          aria-label="X profile"
          title="X"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M18.9 2.25h3.68l-8.04 9.19L24 21.75h-7.41l-5.8-7.59-6.64 7.59H.46l8.6-9.83L0 2.25h7.6l5.24 6.93 6.06-6.93Zm-1.29 17.3h2.04L6.49 4.34H4.3L17.61 19.55Z" />
          </svg>
        </a>
      </div>
    </section>

    <section class="v2-section v2-platform-section" aria-labelledby="platform-title">
      <div class="v2-section-heading v2-platform-heading">
        <h2 id="platform-title">Systems I’m building.</h2>
        <p>
          At QuantJourney, I build the tools behind research, portfolio decisions and investment operations.
        </p>
      </div>
      <div class="v2-product-proof">
        {productProof.map((product) => (
          <a class="v2-product-row" href={product.href} target="_blank" rel="noopener">
            <strong>{product.name}</strong>
            <span>{product.summary}</span>
            <span class="v2-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      <p class="v2-platform-note">
        QuantJourney builds investment technology. It does not manage client assets or provide investment advice.
      </p>
    </section>

    <section class="v2-section v2-background-section" aria-labelledby="background-title">
      <figure class="v2-background-image">
        <img
          src="/jpbg.jpeg"
          alt="Jakub Połeć with Bill Gates during his Microsoft years"
          width="800"
          height="796"
          loading="lazy"
          decoding="async"
        />
        <figcaption>With Bill Gates, during my Microsoft years.</figcaption>
      </figure>
      <div class="v2-background-copy">
        <h2 id="background-title">From high-energy physics to quantitative systems.</h2>
        <p>
          My path has taken me from high-energy physics through Microsoft, technology entrepreneurship
          and Oracle to quantitative finance. At Oracle, I was {profile.career.oracleTitle}.
        </p>
        <p>
          I bring that background to the engineering details that matter in quantitative work:
          data quality, reproducible research, portfolio constraints and systems that can be maintained.
        </p>
      </div>
    </section>

    <section class="v2-section v2-public-work" aria-labelledby="public-title">
      <div class="v2-section-heading">
        <h2 id="public-title">Writing and code.</h2>
        <p>Research notes, technical examples and resources for quantitative developers.</p>
      </div>
      <div class="v2-public-links">
        <a href="https://quant-interviews.quantjourney.cloud" target="_blank" rel="noopener">
          <strong>Quant Interviews</strong>
          <span>1,600+ pages · 190+ problems · Python / C++ / SQL</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a href="https://quantjourney.substack.com" target="_blank" rel="noopener">
          <strong>Quant Blog</strong>
          <span>200+ posts on research, markets, infrastructure and applied AI</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a href="https://github.com/jpolec" target="_blank" rel="noopener">
          <strong>GitHub</strong>
          <span>Public repositories, working examples and releases</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="v2-closing" aria-labelledby="closing-title">
      <h2 id="closing-title">Work with me.</h2>
      <p>
        I take on selected projects in quantitative development, data and platform architecture,
        research and backtest validation, and technical due diligence.
      </p>
      <p class="v2-closing-note">
        Share your objective, current system and main constraint.
        We can start with a focused technical review and define a practical scope of work.
      </p>
      <a class="v2-closing-contact" href={profile.urls.email}>Discuss a project <span aria-hidden="true">↗</span></a>
    </section>
  </main>
</SimpleLayout>

<style>
  .v2-page-shell {
    --v2-accent: #aa0a8b;
    --v2-body: #36516e;
    width: min(1020px, calc(100% - 64px));
    margin: 0 auto;
    padding: clamp(40px, 6vw, 64px) 0 48px;
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.65;
  }

  h1, h2, p { margin: 0; }
  h1, h2, strong { font-weight: 600; }
  h1, h2 { color: var(--ink); text-wrap: balance; }

  .v2-hero h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    letter-spacing: -0.045em;
    line-height: 1.15;
  }

  h2 {
    font-size: 1.5rem;
    letter-spacing: -0.025em;
    line-height: 1.35;
  }

  p, figcaption { color: var(--v2-body); text-wrap: pretty; }
  .v2-page-shell a { font: inherit; }

  .v2-page-shell a:focus-visible {
    outline: 2px solid var(--v2-accent);
    outline-offset: 5px;
  }

  .v2-hero {
    max-width: 760px;
    padding-bottom: clamp(36px, 5vw, 48px);
  }

  .v2-role { margin-top: 14px; color: var(--ink); font-weight: 600; }
  .v2-hero-copy { max-width: 720px; margin-top: 18px; }
  .v2-hero-copy + .v2-hero-copy { margin-top: 12px; }

  .v2-contact-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
  }

  .v2-button, .v2-social-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 6px;
    text-decoration: none;
    transition: background 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .v2-button {
    gap: 24px;
    padding: 8px 18px;
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }

  .v2-social-link { width: 44px; height: 44px; }
  .v2-social-link svg { width: 18px; height: 18px; fill: currentColor; }

  .v2-button:hover, .v2-social-link:hover {
    border-color: var(--v2-accent);
    background: var(--v2-accent);
    color: #fff;
  }

  .v2-section, .v2-closing {
    padding: clamp(32px, 4vw, 44px) 0;
    border-top: 1px solid var(--line);
  }

  .v2-section-heading > p { margin-top: 12px; }
  .v2-platform-heading { max-width: 720px; margin-bottom: 24px; }

  .v2-product-proof { display: grid; }

  .v2-product-row {
    display: grid;
    grid-template-columns: minmax(150px, 0.4fr) minmax(0, 1fr) auto;
    gap: 24px;
    align-items: baseline;
    min-width: 0;
    padding: 16px 0;
    border-top: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }

  .v2-product-row strong, .v2-public-links strong {
    color: var(--v2-accent);
  }

  .v2-product-row > span:not(.v2-arrow), .v2-public-links span {
    color: var(--v2-body);
    text-wrap: pretty;
  }

  .v2-arrow { color: var(--ink); }

  .v2-product-row:hover strong, .v2-public-links a:hover strong {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  .v2-platform-note { margin-top: 16px; max-width: 850px; }

  .v2-background-section, .v2-public-work {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(28px, 5vw, 58px);
  }

  .v2-background-section { align-items: center; }
  .v2-background-image { margin: 0; }
  .v2-background-image img { width: 100%; height: auto; border-radius: 6px; }
  .v2-background-image figcaption { margin-top: 10px; }
  .v2-background-copy p { margin-top: 18px; }
  .v2-public-links { min-width: 0; }

  .v2-public-links a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 5px 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }

  .v2-public-links a:first-child { padding-top: 0; }
  .v2-public-links a:last-child { border-bottom: 0; padding-bottom: 0; }
  .v2-public-links span { grid-column: 1; }
  .v2-public-links span:last-child { grid-column: 2; grid-row: 1; color: var(--ink); }

  .v2-closing { padding-bottom: 0; }
  .v2-closing p { max-width: 760px; margin-top: 18px; }
  .v2-closing .v2-closing-note { margin-top: 12px; }

  .v2-closing-contact {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    min-height: 44px;
    margin-top: 16px;
    color: var(--v2-accent);
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .v2-closing-contact:hover { color: var(--ink); }

  @media (max-width: 760px) {
    .v2-page-shell { width: calc(100% - 40px); padding: 36px 0 24px; }
    .v2-background-section, .v2-public-work { grid-template-columns: 1fr; }

    .v2-product-row { grid-template-columns: minmax(0, 1fr) auto; gap: 6px 16px; }
    .v2-product-row > span:not(.v2-arrow) { grid-column: 1; }
    .v2-arrow { grid-column: 2; grid-row: 1; }
    .v2-background-image { max-width: 360px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .v2-page-shell a { transition: none; }
  }
</style>
