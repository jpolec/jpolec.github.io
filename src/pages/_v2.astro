---
import SimpleLayout from '../layouts/SimpleLayout.astro';
import { profile } from '../data/profile';

const productProof = [
  {
    name: 'OneBook',
    summary: 'Research, portfolio state, risk, approvals and execution context in one operating layer.',
    href: 'https://onebook.quantjourney.cloud/',
  },
  {
    name: 'Quant API / MCP',
    summary: 'Governed financial-data routes for applications, SDKs and approved AI clients.',
    href: 'https://api.quantjourney.cloud/',
  },
  {
    name: 'Quant DataLake',
    summary: 'Warehouse-backed market, fundamental, portfolio and analytical workflows.',
    href: 'https://data.quantjourney.cloud/',
  },
  {
    name: 'Backtester',
    summary: 'Reproducible systematic research, diagnostics and review-ready outputs.',
    href: 'https://backtester.quantjourney.cloud/',
  },
  {
    name: 'Agents',
    summary: 'Controlled AI access with OAuth, scoped tools and evidence-aware responses.',
    href: 'https://agents.quantjourney.cloud/',
  },
];

---

<SimpleLayout
  title="Jakub Połeć | Quant Systems Architect & Founder of QuantJourney"
  description={profile.description}
  canonical="https://jakubpolec.com/_v2/"
  noindex={true}
>
  <main class="v2-page-shell">
    <section class="v2-hero" aria-labelledby="v2-title">
      <h1 id="v2-title">Jakub Połeć</h1>
      <p class="v2-role">Quant Systems Architect &amp; Founder of QuantJourney</p>
      <p class="v2-hero-copy">
        I work across quantitative research, data, portfolio, risk and AI infrastructure for investment teams —
        and invest proprietary capital independently.
      </p>
      <p class="v2-hero-copy">
        QuantJourney is investment technology: it builds research tools, data infrastructure and
        portfolio-decision software. It does not manage client assets or provide investment advice.
      </p>
      <div class="v2-contact-row" aria-label="Contact links">
        <a class="v2-button" href={profile.urls.email}>Email me</a>
        <a
          class="v2-social-link"
          href="https://linkedin.com/in/jakubpolec"
          target="_blank"
          rel="noopener"
          aria-label="LinkedIn profile"
          title="LinkedIn"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M6.94 8.5A1.72 1.72 0 1 0 6.94 5.06a1.72 1.72 0 0 0 0 3.44ZM5.48 18.94h2.93V10H5.48v8.94ZM10.25 10v8.94h2.92v-4.42c0-1.17.22-2.3 1.67-2.3 1.43 0 1.45 1.34 1.45 2.38v4.34h2.93v-4.93c0-2.42-.52-4.28-3.35-4.28-1.36 0-2.27.74-2.64 1.45h-.04V10h-2.94Z" />
          </svg>
        </a>
        <a
          class="v2-social-link"
          href="https://x.com/jakubpolec"
          target="_blank"
          rel="noopener"
          aria-label="X profile"
          title="X"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M18.9 2.25h3.68l-8.04 9.19L24 21.75h-7.41l-5.8-7.59-6.64 7.59H.46l8.6-9.83L0 2.25h7.6l5.24 6.93 6.06-6.93Zm-1.29 17.3h2.04L6.49 4.34H4.3L17.61 19.55Z" />
          </svg>
        </a>
      </div>
    </section>

    <section class="v2-section v2-platform-section" aria-labelledby="platform-title">
      <div class="v2-section-heading v2-platform-heading">
        <p class="v2-section-kicker">What I build</p>
        <h2 id="platform-title">Products and proprietary infrastructure for investment work.</h2>
        <p>
          A connected body of work around governed research, data, portfolio, risk and AI workflows.
          These are the systems I spend my time designing, building and operating.
        </p>
      </div>
      <div class="v2-product-proof">
        {productProof.map((product) => (
          <a class="v2-product-row" href={product.href} target="_blank" rel="noopener">
            <strong>{product.name}</strong>
            <span>{product.summary}</span>
            <span class="v2-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="v2-section v2-background-section" aria-labelledby="background-title">
      <figure class="v2-background-image">
        <img
          src="/jpbg.jpeg"
          alt="Jakub Połeć with Bill Gates during his Microsoft years"
          width="440"
          height="550"
          loading="lazy"
          decoding="async"
        />
        <figcaption>With Bill Gates, during Jakub’s Microsoft years.</figcaption>
      </figure>
      <div class="v2-background-copy">
        <p class="v2-section-kicker">Background</p>
        <h2 id="background-title">From high-energy physics to quantitative systems.</h2>
        <p>
          My path runs from high-energy physics through Microsoft, technology entrepreneurship and
          Oracle — where I was Head of Industry and Innovation, Director, ECEMEA — to quantitative finance.
        </p>
        <p>
          That background matters when an investment team needs more than a conceptual architecture:
          a system that respects real data, portfolio, risk and operational constraints.
        </p>
        <p>
          Today I build QuantJourney, an investment-technology platform for institutional research,
          data, portfolio, risk and AI infrastructure.
        </p>
      </div>
    </section>

    <section class="v2-section v2-public-work" aria-labelledby="public-title">
      <div class="v2-section-heading">
        <p class="v2-section-kicker">Public work</p>
        <h2 id="public-title">Research and working material, openly available.</h2>
      </div>
      <div class="v2-public-links">
        <a href="https://quant-interviews.quantjourney.cloud" target="_blank" rel="noopener">
          <strong>Quant Interviews</strong>
          <span>1,600+ pages · 190+ problems · Python / C++ / SQL</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a href="https://quantjourney.substack.com" target="_blank" rel="noopener">
          <strong>Quant Blog</strong>
          <span>200+ posts on quantitative research, markets, infrastructure and applied AI</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a href="https://github.com/jpolec" target="_blank" rel="noopener">
          <strong>GitHub</strong>
          <span>Public repositories, working examples and release history</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="v2-closing" aria-labelledby="closing-title">
      <p class="v2-section-kicker">Work with me</p>
      <h2 id="closing-title">Selective work for investment teams.</h2>
      <p>
        I work selectively with funds, family offices and investment-technology companies on
        infrastructure architecture, technical due diligence, research design and strategy or
        backtest validation.
      </p>
      <p class="v2-closing-note">Where useful, work begins with a short, focused review of the decision and operating context.</p>
    </section>
  </main>
</SimpleLayout>

<style>
  .v2-page-shell {
    width: min(1020px, calc(100% - 40px));
    margin: 0 auto;
    padding: 48px 0 58px;
    color: var(--ink);
  }

  .v2-hero {
    max-width: 760px;
    padding: 10px 0 50px;
  }

  .v2-section-kicker {
    margin: 0 0 16px;
    color: #aa0a8b;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .v2-hero h1,
  .v2-section h2,
  .v2-closing h2 {
    margin: 0;
    color: var(--ink);
    font-weight: 650;
    letter-spacing: -0.043em;
  }

  .v2-hero h1 {
    font-size: clamp(2.55rem, 5vw, 4.25rem);
    line-height: 1;
  }

  .v2-role {
    margin: 12px 0 24px;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.5;
  }

  .v2-hero-copy {
    max-width: 720px;
    margin: 0 0 14px;
    color: #244366;
    font-size: 1rem;
    line-height: 1.62;
  }

  .v2-contact-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
  }

  .v2-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    border: 1px solid var(--ink);
    border-radius: 7px;
    padding: 10px 14px;
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 750;
    line-height: 1.1;
    text-decoration: none;
    transition: background 160ms ease, border-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .v2-button:hover {
    background: #aa0a8b;
    border-color: #aa0a8b;
    color: #ffffff;
    transform: translateY(-1px);
  }

  .v2-social-link {
    display: inline-flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--ink);
    border-radius: 7px;
    color: var(--ink);
    transition: background 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .v2-social-link svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .v2-social-link:hover {
    border-color: #aa0a8b;
    background: #aa0a8b;
    color: #ffffff;
  }

  .v2-section h2,
  .v2-closing h2 {
    font-size: clamp(1.75rem, 3vw, 2.65rem);
    line-height: 1.08;
  }

  .v2-section {
    padding: clamp(46px, 6vw, 68px) 0;
    border-bottom: 1px solid var(--line);
  }

  .v2-section-heading {
    max-width: 700px;
  }

  .v2-section-heading > p:not(.v2-section-kicker) {
    margin: 20px 0 0;
    color: #244366;
    font-size: 1rem;
    line-height: 1.65;
  }

  .v2-platform-section {
    padding-bottom: 0;
  }

  .v2-platform-heading {
    margin-bottom: 34px;
  }

  .v2-product-proof {
    border-top: 1px solid var(--line);
  }

  .v2-product-row {
    display: grid;
    grid-template-columns: minmax(160px, 0.62fr) minmax(0, 2.2fr) auto;
    gap: 24px;
    align-items: center;
    padding: 22px 0;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: color 150ms ease;
  }

  .v2-product-row:hover strong,
  .v2-product-row:hover .v2-arrow {
    color: #aa0a8b;
  }

  .v2-product-row strong {
    color: #aa0a8b;
    font-size: 0.93rem;
    line-height: 1.35;
  }

  .v2-product-row > span:not(.v2-arrow) {
    color: #244366;
    font-size: 0.91rem;
    line-height: 1.5;
  }

  .v2-arrow {
    color: var(--ink);
    font-size: 1rem;
    font-weight: 700;
  }

  .v2-background-section {
    display: grid;
    grid-template-columns: minmax(240px, 0.68fr) minmax(0, 1.2fr);
    gap: clamp(36px, 7vw, 92px);
    align-items: start;
  }

  .v2-background-image {
    margin: 0;
  }

  .v2-background-image img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .v2-background-image figcaption {
    margin-top: 8px;
    color: #64748b;
    font-size: 0.68rem;
    line-height: 1.45;
  }

  .v2-background-copy {
    max-width: 660px;
  }

  .v2-background-copy p:not(.v2-section-kicker) {
    margin: 18px 0 0;
    color: #244366;
    font-size: 1rem;
    line-height: 1.65;
  }

  .v2-public-work {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(36px, 7vw, 92px);
  }

  .v2-public-links {
    border-top: 1px solid var(--line);
  }

  .v2-public-links a {
    display: grid;
    grid-template-columns: minmax(130px, 0.75fr) minmax(0, 1.55fr) auto;
    gap: 18px;
    align-items: center;
    padding: 19px 0;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .v2-public-links strong {
    color: #aa0a8b;
    font-size: 0.89rem;
    line-height: 1.4;
  }

  .v2-public-links span {
    color: #365575;
    font-size: 0.84rem;
    line-height: 1.45;
  }

  .v2-public-links span:last-child {
    color: var(--ink);
    font-size: 1rem;
    font-weight: 700;
  }

  .v2-public-links a:hover strong,
  .v2-public-links a:hover span:last-child {
    color: #aa0a8b;
  }

  .v2-closing {
    max-width: 860px;
    padding: clamp(48px, 6vw, 70px) 0 12px;
  }

  .v2-closing p:not(.v2-section-kicker) {
    max-width: 660px;
    margin: 22px 0 0;
    color: #244366;
    font-size: 1.04rem;
    line-height: 1.65;
  }

  .v2-closing .v2-closing-note {
    margin-top: 12px;
    color: #64748b;
    font-size: 0.87rem;
  }

  @media (max-width: 760px) {
    .v2-page-shell {
      width: min(100% - 32px, 640px);
      padding-top: 32px;
    }

    .v2-hero h1 {
      font-size: clamp(2.45rem, 11vw, 3.4rem);
    }

    .v2-background-section,
    .v2-public-work {
      grid-template-columns: 1fr;
    }

    .v2-product-row,
    .v2-public-links a {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 6px 16px;
      align-items: start;
    }

    .v2-product-row > span:not(.v2-arrow),
    .v2-public-links a > span:not(:last-child) {
      grid-column: 1 / 2;
    }

    .v2-arrow,
    .v2-public-links a > span:last-child {
      grid-column: 2;
      grid-row: 1;
    }

    .v2-background-image {
      max-width: 340px;
    }

    .v2-public-work {
      gap: 36px;
    }

  }
</style>
