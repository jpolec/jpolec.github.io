---
import SimpleLayout from '../layouts/SimpleLayout.astro';
import { profile } from '../data/profile';

const productProof = [
  {
    name: 'OneBook',
    summary: 'Research, portfolio, risk and execution context in one workspace.',
    href: 'https://onebook.quantjourney.cloud/',
  },
  {
    name: 'Quant API / MCP',
    summary: 'Financial data for applications, research and approved AI clients.',
    href: 'https://api.quantjourney.cloud/',
  },
  {
    name: 'Quant DataLake',
    summary: 'Market, fundamental and portfolio data for analytical workflows.',
    href: 'https://data.quantjourney.cloud/',
  },
  {
    name: 'Backtester',
    summary: 'Reproducible strategy research, diagnostics and backtest results.',
    href: 'https://backtester.quantjourney.cloud/',
  },
  {
    name: 'Agents',
    summary: 'AI tools with scoped access and responses grounded in evidence.',
    href: 'https://agents.quantjourney.cloud/',
  },
];

---

<SimpleLayout
  title="Jakub Połeć | Quant Systems Architect & Founder of QuantJourney"
  description={profile.description}
  canonical="https://jakubpolec.com/_v2/"
  noindex={true}
>
  <main class="v2-page-shell">
    <section class="v2-hero" aria-labelledby="v2-title">
      <h1 id="v2-title">{profile.name}<span class="v2-name-dot" aria-hidden="true">.</span></h1>
      <p class="v2-role">{profile.role}</p>
      <p class="v2-hero-copy">
        I build systems that connect research, data and investment decisions.
        At QuantJourney, my work spans portfolio, risk and AI infrastructure for investment teams.
      </p>
      <p class="v2-personal-note">I also invest my own capital independently.</p>
      <div class="v2-contact-row" aria-label="Contact links">
        <a class="v2-button" href={profile.urls.email}>Email me <span aria-hidden="true">↗</span></a>
        <a
          class="v2-social-link"
          href="https://linkedin.com/in/jakubpolec"
          target="_blank"
          rel="noopener"
          aria-label="LinkedIn profile"
          title="LinkedIn"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M6.94 8.5A1.72 1.72 0 1 0 6.94 5.06a1.72 1.72 0 0 0 0 3.44ZM5.48 18.94h2.93V10H5.48v8.94ZM10.25 10v8.94h2.92v-4.42c0-1.17.22-2.3 1.67-2.3 1.43 0 1.45 1.34 1.45 2.38v4.34h2.93v-4.93c0-2.42-.52-4.28-3.35-4.28-1.36 0-2.27.74-2.64 1.45h-.04V10h-2.94Z" />
          </svg>
        </a>
        <a
          class="v2-social-link"
          href="https://x.com/jakubpolec"
          target="_blank"
          rel="noopener"
          aria-label="X profile"
          title="X"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M18.9 2.25h3.68l-8.04 9.19L24 21.75h-7.41l-5.8-7.59-6.64 7.59H.46l8.6-9.83L0 2.25h7.6l5.24 6.93 6.06-6.93Zm-1.29 17.3h2.04L6.49 4.34H4.3L17.61 19.55Z" />
          </svg>
        </a>
      </div>
    </section>

    <section class="v2-section v2-platform-section" aria-labelledby="platform-title">
      <div class="v2-section-heading v2-platform-heading">
        <h2 id="platform-title">What I’m building.</h2>
        <p>
          Connected tools for the investment workflow, built at QuantJourney.
        </p>
      </div>
      <div class="v2-product-proof">
        {productProof.map((product) => (
          <a class="v2-product-row" href={product.href} target="_blank" rel="noopener">
            <strong>{product.name}</strong>
            <span>{product.summary}</span>
            <span class="v2-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      <p class="v2-platform-note">
        QuantJourney builds investment technology. It does not manage client assets or provide investment advice.
      </p>
    </section>

    <section class="v2-section v2-background-section" aria-labelledby="background-title">
      <figure class="v2-background-image">
        <img
          src="/jpbg.jpeg"
          alt="Jakub Połeć with Bill Gates during his Microsoft years"
          width="800"
          height="796"
          loading="lazy"
          decoding="async"
        />
        <figcaption>With Bill Gates, during my Microsoft years.</figcaption>
      </figure>
      <div class="v2-background-copy">
        <h2 id="background-title">From high-energy physics to quantitative systems.</h2>
        <p>
          My path has taken me from high-energy physics through Microsoft, technology entrepreneurship
          and Oracle to quantitative finance. At Oracle, I was {profile.career.oracleTitle}.
        </p>
        <p>
          That experience shapes how I build today: connecting research ideas to working systems,
          with the data quality, portfolio constraints and operational detail that investment teams rely on.
        </p>
      </div>
    </section>

    <section class="v2-section v2-public-work" aria-labelledby="public-title">
      <div class="v2-section-heading">
        <h2 id="public-title">Ideas in public.</h2>
        <p>Writing, code and resources for people working in quantitative finance.</p>
      </div>
      <div class="v2-public-links">
        <a href="https://quant-interviews.quantjourney.cloud" target="_blank" rel="noopener">
          <strong>Quant Interviews</strong>
          <span>1,600+ pages · 190+ problems · Python / C++ / SQL</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a href="https://quantjourney.substack.com" target="_blank" rel="noopener">
          <strong>Quant Blog</strong>
          <span>200+ posts on research, markets, infrastructure and applied AI</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a href="https://github.com/jpolec" target="_blank" rel="noopener">
          <strong>GitHub</strong>
          <span>Public repositories, working examples and releases</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="v2-closing" aria-labelledby="closing-title">
      <h2 id="closing-title">Working on a difficult investment-systems problem?</h2>
      <p>
        I work selectively with funds, family offices and investment-technology companies on
        architecture, technical due diligence, research design and strategy validation.
      </p>
      <p class="v2-closing-note">Tell me what you’re building and where you’re getting stuck.</p>
      <a class="v2-closing-contact" href={profile.urls.email}>Let’s talk <span aria-hidden="true">↗</span></a>
    </section>
  </main>
</SimpleLayout>

<style>
  .v2-page-shell {
    --v2-accent: #aa0a8b;
    --v2-body: #36516e;
    --v2-muted: #5c6b7c;
    width: min(1020px, calc(100% - 64px));
    margin: 0 auto;
    padding: clamp(48px, 7vw, 88px) 0 48px;
    color: var(--ink);
  }

  .v2-page-shell a:focus-visible {
    outline: 2px solid var(--v2-accent);
    outline-offset: 5px;
  }

  .v2-hero {
    max-width: 780px;
    padding-bottom: clamp(44px, 6vw, 64px);
  }

  h1, h2, p { margin: 0; }

  h1, h2 {
    color: var(--ink);
    font-weight: 600;
    text-wrap: balance;
  }

  .v2-hero h1 {
    font-size: clamp(3.25rem, 7vw, 5.25rem);
    letter-spacing: -0.065em;
    line-height: 1.06;
  }

  .v2-name-dot { color: var(--v2-accent); }

  .v2-role {
    margin-top: 16px;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.6;
  }

  .v2-hero-copy {
    max-width: 690px;
    margin-top: 24px;
    color: var(--v2-body);
    font-size: clamp(1.125rem, 1.9vw, 1.25rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .v2-personal-note {
    margin-top: 12px;
    color: var(--v2-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .v2-contact-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 26px;
  }

  .v2-button, .v2-social-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 6px;
    text-decoration: none;
    transition: background 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .v2-button {
    gap: 24px;
    padding: 12px 18px;
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .v2-social-link { width: 44px; height: 44px; }
  .v2-social-link svg { width: 18px; height: 18px; fill: currentColor; }

  .v2-button:hover, .v2-social-link:hover {
    border-color: var(--v2-accent);
    background: var(--v2-accent);
    color: #fff;
  }

  h2 {
    font-size: clamp(1.625rem, 2.6vw, 2rem);
    letter-spacing: -0.04em;
    line-height: 1.2;
  }

  .v2-section {
    padding: clamp(36px, 4.5vw, 48px) 0;
    border-top: 1px solid var(--line);
  }

  .v2-section-heading > p {
    margin-top: 12px;
    color: var(--v2-body);
    font-size: 1rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .v2-platform-heading { margin-bottom: 26px; }

  .v2-product-proof {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 36px;
  }

  .v2-product-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 16px;
    align-items: start;
    min-width: 0;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }

  .v2-product-row:first-child {
    grid-column: 1 / -1;
    grid-template-columns: minmax(140px, 0.45fr) minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px 24px;
    padding: 22px 24px;
    margin-bottom: 8px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #f5f7fa;
  }

  .v2-product-row:first-child > span:not(.v2-arrow) { grid-column: 2; }
  .v2-product-row:first-child .v2-arrow { grid-column: 3; }

  .v2-product-row strong {
    color: var(--v2-accent);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .v2-product-row:first-child strong { font-size: 1.375rem; }

  .v2-product-row > span:not(.v2-arrow) {
    grid-column: 1;
    color: var(--v2-body);
    font-size: 1rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .v2-arrow {
    grid-column: 2;
    grid-row: 1;
    color: var(--v2-muted);
    font-size: 1.125rem;
    line-height: 1.5;
    transition: color 160ms ease, transform 160ms ease;
  }

  .v2-product-row:hover strong,
  .v2-public-links a:hover strong {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  .v2-product-row:hover .v2-arrow {
    color: var(--v2-accent);
    transform: translate(2px, -2px);
  }

  .v2-platform-note {
    margin-top: 12px;
    max-width: 750px;
    color: var(--v2-muted);
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .v2-background-section {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(28px, 5vw, 58px);
    align-items: center;
  }

  .v2-background-image { margin: 0; }

  .v2-background-image img {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .v2-background-image figcaption {
    margin-top: 10px;
    color: var(--v2-muted);
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .v2-background-copy p {
    margin-top: 18px;
    color: var(--v2-body);
    font-size: 1rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .v2-public-work {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(28px, 5vw, 58px);
  }

  .v2-public-links { min-width: 0; }

  .v2-public-links a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 5px 24px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }

  .v2-public-links a:first-child { padding-top: 0; }
  .v2-public-links a:last-child { border-bottom: 0; padding-bottom: 0; }

  .v2-public-links strong {
    color: var(--v2-accent);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .v2-public-links span {
    grid-column: 1;
    color: var(--v2-body);
    font-size: 1rem;
    line-height: 1.6;
  }

  .v2-public-links span:last-child {
    grid-column: 2;
    grid-row: 1;
    color: var(--v2-muted);
    font-size: 1.125rem;
  }

  .v2-closing {
    padding: clamp(26px, 4vw, 40px);
    border: 1px solid var(--line);
    border-left: 3px solid var(--v2-accent);
    border-radius: 0 8px 8px 0;
    background: #f5f7fa;
  }

  .v2-closing h2 { max-width: 660px; }

  .v2-closing p {
    max-width: 740px;
    margin-top: 18px;
    color: var(--v2-body);
    font-size: 1rem;
    line-height: 1.7;
  }

  .v2-closing .v2-closing-note {
    margin-top: 10px;
    color: var(--v2-muted);
  }

  .v2-closing-contact {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    min-height: 44px;
    margin-top: 16px;
    color: var(--v2-accent);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .v2-closing-contact:hover { color: var(--ink); }

  @media (max-width: 760px) {
    .v2-page-shell {
      width: calc(100% - 40px);
      padding-top: 40px;
      padding-bottom: 24px;
    }

    .v2-hero h1 { font-size: clamp(2.75rem, 10vw, 4rem); }
    .v2-hero-copy { margin-top: 20px; }

    .v2-background-section, .v2-public-work { grid-template-columns: 1fr; }
    .v2-product-proof { grid-template-columns: 1fr; }

    .v2-product-row:first-child {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 6px 16px;
      padding: 20px;
    }

    .v2-product-row:first-child > span:not(.v2-arrow) { grid-column: 1; }
    .v2-product-row:first-child .v2-arrow { grid-column: 2; }
    .v2-background-image { max-width: 360px; }
    .v2-public-work { gap: 28px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .v2-page-shell a, .v2-arrow { transition: none; }
    .v2-product-row:hover .v2-arrow { transform: none; }
  }
</style>
