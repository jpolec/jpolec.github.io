---
import SimpleLayout from '../layouts/SimpleLayout.astro';
import { profile } from '../data/profile';

const products = [
  {
    name: 'OneBook',
    destination: 'onebook.quantjourney.cloud',
    description: 'A buy-side investment operating layer connecting research, portfolio state, risk, decisions, and execution.',
    href: 'https://onebook.quantjourney.cloud/',
    action: 'Open OneBook',
    external: true,
  },
  {
    name: 'Quant API / MCP',
    destination: 'api.quantjourney.cloud',
    description: 'Managed financial-data infrastructure with governed routes, normalized contracts, and approved MCP access.',
    href: 'https://api.quantjourney.cloud',
    action: 'Open Quant API / MCP',
    external: true,
  },
  {
    name: 'Quant DataLake',
    destination: 'data.quantjourney.cloud',
    description: 'A financial-data workspace for approved market, fundamentals, portfolio, and analytical workflows.',
    href: 'https://data.quantjourney.cloud',
    action: 'Open Quant DataLake',
    external: true,
  },
  {
    name: 'Backtester',
    destination: 'backtester.quantjourney.cloud',
    description: 'Python-native strategy research with reproducible workflows, diagnostics, and reviewable outputs.',
    href: 'https://backtester.quantjourney.cloud',
    action: 'Open Backtester',
    external: true,
  },
  {
    name: 'Quant Infra',
    destination: 'quantjourney.cloud',
    description: 'Proprietary infrastructure design and delivery for hedge funds, other investment funds, family offices, and investment teams.',
    href: 'https://quantjourney.cloud',
    action: 'Open Quant Infra',
    external: true,
  },
  {
    name: 'Agents',
    destination: 'agents.quantjourney.cloud',
    description: 'Controlled tools for approved financial and investment workflows, with OAuth, scoped access, and MCP.',
    href: 'https://agents.quantjourney.cloud',
    action: 'Open Agents',
    external: true,
  },
];

// Curated for investment teams; titles and topics checked against the public
// article pages. These are editorial selections, not a popularity ranking.
const selectedPosts = [
  {
    title: 'Designing a Real Portfolio Management System (Not a Positions UI)',
    description: 'PMS design: keeping positions and cash consistent, with portfolio state that can be rebuilt day by day.',
    href: 'https://quantjourney.substack.com/p/designing-a-real-portfolio-management',
  },
  {
    title: 'Investment Memory: Why Most Portfolio Systems Lie to You',
    description: 'IBOR and portfolio history: reconstructing what was known at the time, including weights, flows and risk state.',
    href: 'https://quantjourney.substack.com/p/investment-memory-why-most-portfolio',
  },
  {
    title: 'The Hidden Problem in Buy-Side Platforms: Which Investment State Is True?',
    description: 'Data and orchestration: checking that risk, analytics and reporting use consistent investment state when inputs change.',
    href: 'https://quantjourney.substack.com/p/the-hidden-problem-in-buy-side-platforms',
  },
  {
    title: 'AI-Agent-Native Investment Infrastructure: MCP Access to IBOR, PMS, Risk and Research',
    description: 'Applied AI: connecting agents to controlled portfolio, market-data, risk and research infrastructure through MCP.',
    href: 'https://quantjourney.substack.com/p/ai-agent-native-investment-infrastructure',
  },
];

---

<SimpleLayout
  title={profile.name}
  description={profile.description}
  canonical="https://jakubpolec.com/_v14/"
  noindex={true}
>
  <main class="page-shell">
    <section class="hero" aria-labelledby="hero-title">
      <figure class="hero-image-wrap animate-in">
        <img
          src="/jpbg.jpeg"
          alt="Jakub Połeć with Bill Gates during his Microsoft years"
          class="hero-image"
          width="440"
          height="550"
          loading="eager"
          decoding="async"
        />
        <figcaption>With Bill Gates, during my Microsoft years.</figcaption>
      </figure>

      <div class="hero-copy">
        <h1 id="hero-title" class="animate-in">{profile.name}</h1>
        <p class="role animate-in">{profile.role}</p>
        <p class="lead animate-in">
          I design and build research, data, portfolio, risk and AI systems for investment teams.
        </p>
        <div class="hero-about animate-in">
          <p>
            I can help you develop a new system, improve an existing platform, or review your
            architecture, strategies and backtests as part of technical due diligence.
          </p>
          <p>
            I work with hedge funds, family offices, asset managers and
            investment-technology companies.
          </p>
          <h2 class="bio-title">From physics to quantitative systems</h2>
          <p>My path runs from high-energy physics through Microsoft, technology entrepreneurship and Oracle to quantitative finance.</p>
          <p>At Oracle, I was {profile.career.oracleTitle}. Today, my work focuses on quantitative development and investment infrastructure.</p>
          <p>I care about the assumptions inside a model as much as the system around it.</p>
        </div>

        <div class="action-row hero-actions animate-in" aria-label="Contact links">
          <a
            href="https://calendly.com/jpolec/30min"
            class="button primary"
            target="_blank"
            rel="noopener"
          >
            Set up a meeting
          </a>
          <a href="mailto:jakub@quantjourney.pro" class="button primary">
            Email me
          </a>
          <a
            href="https://linkedin.com/in/jakubpolec"
            class="button primary social-icon"
            target="_blank"
            rel="noopener"
            aria-label="LinkedIn profile"
            title="LinkedIn"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M6.94 8.5A1.72 1.72 0 1 0 6.94 5.06a1.72 1.72 0 0 0 0 3.44ZM5.48 18.94h2.93V10H5.48v8.94ZM10.25 10v8.94h2.92v-4.42c0-1.17.22-2.3 1.67-2.3 1.43 0 1.45 1.34 1.45 2.38v4.34h2.93v-4.93c0-2.42-.52-4.28-3.35-4.28-1.36 0-2.27.74-2.64 1.45h-.04V10h-2.94Z" />
            </svg>
          </a>
          <a
            href="https://x.com/jakubpolec"
            class="button primary social-icon"
            target="_blank"
            rel="noopener"
            aria-label="X profile"
            title="X"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M18.9 2.25h3.68l-8.04 9.19L24 21.75h-7.41l-5.8-7.59-6.64 7.59H.46l8.6-9.83L0 2.25h7.6l5.24 6.93 6.06-6.93Zm-1.29 17.3h2.04L6.49 4.34H4.3L17.61 19.55Z" />
            </svg>
          </a>
          <a
            href="https://github.com/jpolec"
            class="button primary social-icon"
            target="_blank"
            rel="noopener"
            aria-label="GitHub profile"
            title="GitHub"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 .297C5.37.297 0 5.67 0 12.297c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.043-1.61-4.043-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.729.083-.729 1.205.084 1.838 1.237 1.838 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.305-5.466-1.334-5.466-5.93 0-1.31.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23a11.52 11.52 0 0 1 3.003-.404c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.652.242 2.873.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.806 5.621-5.479 5.918.43.372.823 1.102.823 2.222 0 1.606-.015 2.898-.015 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.595 24 12.297c0-6.627-5.373-12-12-12" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <section id="what-i-build" class="build-section animate-in" aria-labelledby="working-title">
      <div class="build-heading">
        <h2 id="working-title">What we build</h2>
        <p>
          At QuantJourney, my team and I build products and proprietary infrastructure
          for research, portfolio workflows, data, and controlled AI access.
        </p>
      </div>
      <div class="build-list">
        {products.map((product) => (
          <article class="build-item">
            <div class="build-name">
              <a
                class="build-identity"
                href={product.href}
                target={product.external ? '_blank' : undefined}
                rel={product.external ? 'noopener' : undefined}
              >
                <h3>{product.name}</h3>
                <span class="build-destination">{product.destination}</span>
              </a>
            </div>
            <p class="build-summary">{product.description}</p>
            <div class="build-action">
              <a
                href={product.href}
                target={product.external ? '_blank' : undefined}
                rel={product.external ? 'noopener' : undefined}
              >
                {product.action} <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
      <p class="platform-note">QuantJourney builds investment technology. It does not manage client capital or provide investment advice.</p>
    </section>

    <section class="articles-section animate-in" aria-labelledby="articles-title">
      <div class="build-heading">
        <h2 id="articles-title">Writing on investment systems</h2>
        <p>I write the QuantJourney blog about quantitative research and the systems behind investment decisions. These four articles explain the design choices behind our portfolio, data and AI infrastructure.</p>
      </div>
      <div class="build-list">
        {selectedPosts.map((post) => (
          <article class="build-item">
            <div class="build-name">
              <a class="build-identity" href={post.href} target="_blank" rel="noopener">
                <h3>{post.title}</h3>
                <span class="build-destination">quantjourney.substack.com</span>
              </a>
            </div>
            <p class="build-summary">{post.description}</p>
            <div class="build-action">
              <a href={post.href} target="_blank" rel="noopener" aria-label={`Read ${post.title}`}>
                Read article <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
      <p class="article-note"><a href="https://quantjourney.substack.com" target="_blank" rel="noopener">More on the QuantJourney blog <span aria-hidden="true">↗</span></a>. Full articles may require a Substack subscription.</p>
    </section>

    <section class="links-section animate-in" aria-labelledby="book-title">
      <div class="book-feature">
        <div class="book-overview">
          <div class="book-heading">
            <h2 id="book-title">
              <a
                class="book-identity"
                href="https://quant-interviews.quantjourney.cloud"
                target="_blank"
                rel="noopener"
              >
                Book Quant Interviews
              </a>
            </h2>
          </div>
          <div class="book-copy">
            <p class="book-stats">1,600+ pages · 190+ problems · Python/C++/SQL</p>
            <p>
              From mathematical foundations to production-grade quant systems.
            </p>
          </div>
          <div class="build-action book-action">
            <a
              href="https://quant-interviews.quantjourney.cloud"
              target="_blank"
              rel="noopener"
            >
              Open Quant Interviews <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div class="book-volume-grid" aria-label="Quant Interviews volumes">
          <article class="book-volume-card">
            <img
              src="/quant-interviews-cover.webp"
              alt="Quant Interviews Volume I cover"
              width="540"
              height="763"
              loading="lazy"
              decoding="async"
            />
            <div class="book-volume-copy">
              <span class="book-volume-label">Volume I</span>
              <span class="book-volume-title">Mathematical Foundations</span>
            </div>
          </article>
          <article class="book-volume-card">
            <img
              src="/quant-interviews-cover.webp"
              alt="Quant Interviews Volume II cover"
              width="540"
              height="763"
              loading="lazy"
              decoding="async"
            />
            <div class="book-volume-copy">
              <span class="book-volume-label">Volume II</span>
              <span class="book-volume-title">Production-Grade Quant Systems</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="content-section work-section animate-in" aria-labelledby="collaborate-title">
      <div>
        <h2 id="collaborate-title">How I work</h2>
      </div>
      <div class="section-copy">
        <p>
          I start with the investment decision or workflow you need to support: who will use
          the system, what data is available and where the current process breaks down.
          We agree on the scope, constraints and how to evaluate the result.
        </p>
        <p>
          I review the existing architecture and research assumptions, including data quality,
          point-in-time history, backtest design and execution costs. The findings determine
          what needs to change and what can stay.
        </p>
        <p>
          My team and I implement the agreed changes, validate them against the requirements
          and document the system for handover. The engagement can be a focused review,
          a specific component or a broader build alongside your team.
        </p>
        <p>Send me a brief outline of what you’re building and where you need help.</p>
      </div>
    </section>

  </main>
</SimpleLayout>

<script>
  // Scroll-triggered fade-in animations
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );

    document.querySelectorAll('.animate-in').forEach((el) =>
      observer.observe(el)
    );
  } else {
    document
      .querySelectorAll('.animate-in')
      .forEach((el) => el.classList.add('visible'));
  }
</script>

<style>
  .page-shell {
    width: min(1080px, calc(100% - 40px));
    margin: 0 auto;
    padding: 42px 0 100px;
    font-family: inherit;
  }

  /* ── Hero ── */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(280px, 440px) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
    min-height: auto;
    padding: 28px 0 24px;
  }

  .hero-image-wrap {
    position: relative;
    z-index: 1;
    margin: 0;
  }

  .hero-image {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .hero-image-wrap figcaption {
    margin: 0;
    padding: 8px 2px 0;
    color: var(--muted);
    font-size: 0.68rem;
    line-height: 1.4;
    text-align: center;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    max-width: 620px;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 14px;
    color: var(--ink);
    font-size: clamp(2.35rem, 5vw, 4.4rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .role {
    margin-bottom: 5px;
    color: var(--ink);
    font-size: clamp(1.05rem, 1.75vw, 1.28rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }

  .founder-line {
    margin-bottom: 22px;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.45;
  }

  .founder-line a {
    font-weight: 600;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }

  .lead {
    max-width: 560px;
    margin-bottom: 24px;
    color: var(--muted);
    font-size: clamp(0.98rem, 1.45vw, 1.12rem);
    line-height: 1.58;
  }

  .hero-about {
    max-width: 590px;
  }

  .hero-about p {
    margin: 0 0 11px;
    color: var(--muted);
    font-size: clamp(0.98rem, 1.45vw, 1.12rem);
    line-height: 1.58;
  }

  .hero-about p:last-child {
    margin-bottom: 0;
  }

  .hero-actions {
    margin-top: 18px;
  }

  .hero-actions .button {
    min-height: 42px;
    padding: 11px 15px;
    font-size: 0.8rem;
  }

  .hero-actions .social-icon {
    width: 42px;
    padding: 9px;
  }

  .social-icon svg {
    width: 17px;
    height: 17px;
    fill: currentColor;
  }

  .action-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--ink);
    border-radius: 8px;
    padding: 13px 18px;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.1;
    text-decoration: none;
    transition: background 160ms ease, color 160ms ease, border-color 160ms ease,
      transform 150ms ease, box-shadow 160ms ease;
  }

  .button:hover {
    background: var(--ink);
    color: var(--page-bg);
    border-color: var(--ink);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.16);
  }

  .button:active {
    transform: translateY(0);
  }

  .button.primary {
    background: transparent;
    color: var(--ink);
  }

  .button.primary:hover {
    background: var(--ink);
    color: var(--page-bg);
    border-color: var(--ink);
  }

  .articles-section {
    margin-top: 38px;
    padding-top: 38px;
    border-top: 1px solid var(--line);
  }

  .article-note { margin: 18px 0 0; font-size: 1rem; line-height: 1.62; color: var(--ink); }
  .article-note a { color: inherit; text-underline-offset: 4px; }
  .hero-about .bio-title {
    margin: 20px 0 11px;
    color: var(--ink);
    font-size: clamp(0.98rem, 1.45vw, 1.12rem);
    font-weight: 600;
    line-height: 1.35;
  }

  .platform-note {
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.62;
  }

  /* ── What we build ── */
  .build-section {
    margin-top: 38px;
    padding: 38px 0 4px;
    border-top: 1px solid var(--line);
  }

  .build-heading {
    max-width: 790px;
    margin-bottom: 28px;
  }

  .build-heading h2 {
    margin: 0 0 10px;
    color: var(--ink);
    font-size: clamp(1.55rem, 2.6vw, 2.2rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .build-heading p {
    margin: 0;
    color: var(--muted);
    font-size: clamp(0.94rem, 1.18vw, 1rem);
    line-height: 1.62;
  }

  .build-list {
    border-top: 1px solid var(--line);
  }

  .build-section .build-list,
  .articles-section .build-list {
    border-top: 0;
  }

  .build-item {
    display: grid;
    grid-template-columns: minmax(190px, 0.68fr) minmax(0, 1.85fr) minmax(135px, 0.48fr);
    gap: 28px;
    align-items: start;
    padding: 29px 0 30px;
    border-bottom: 1px solid var(--line);
  }

  .build-name {
    display: grid;
    gap: 10px;
  }

  .build-identity {
    display: grid;
    width: fit-content;
    gap: 10px;
    color: inherit;
    text-decoration: none;
  }

  .build-name h3 {
    margin: 0;
    color: #aa0a8b;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .build-identity:hover h3 {
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-underline-offset: 3px;
  }

  .build-destination {
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 500;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .build-summary {
    margin: 0;
    color: var(--ink);
    font-size: 0.96rem;
    font-weight: 600;
    line-height: 1.58;
  }

  .build-action {
    padding-top: 1px;
  }

  .build-action a {
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 750;
    line-height: 1.45;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: border-color 160ms ease;
  }

  .build-action a:hover {
    border-color: var(--ink);
  }

  /* ── Content sections ── */
  .content-section {
    display: grid;
    grid-template-columns: minmax(190px, 0.7fr) minmax(0, 1.43fr);
    gap: clamp(24px, 6vw, 90px);
    margin-top: 38px;
    padding: 38px 0 4px;
    border-top: 1px solid var(--line);
  }

  .content-section h2 {
    max-width: 260px;
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.55rem, 2.6vw, 2.2rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .work-section {
    border-top: 0;
  }

  .section-copy {
    max-width: 715px;
  }

  .section-copy > p,
  .text-item p {
    margin: 0 0 14px;
    color: var(--muted);
    font-size: clamp(0.94rem, 1.18vw, 1rem);
    line-height: 1.62;
  }

  .item-stack {
    display: grid;
    gap: 26px;
  }

  .text-item h3 {
    margin-bottom: 8px;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .text-item p:last-child {
    margin-bottom: 0;
  }

  .opportunity-list {
    margin-top: 26px;
  }

  /* ── Links Section ── */
  .links-section {
    margin-top: 38px;
    padding: 38px 0 12px;
  }

  .book-feature {
    margin-bottom: 38px;
  }

  .book-overview {
    display: grid;
    grid-template-columns: minmax(190px, 0.68fr) minmax(0, 1.85fr) minmax(135px, 0.48fr);
    gap: 28px;
  }

  .book-kicker {
    margin: 0 0 10px;
    color: var(--muted);
    font-size: clamp(0.94rem, 1.18vw, 1rem);
    font-weight: 400;
    line-height: 1.62;
    letter-spacing: normal;
  }

  .book-heading h2 {
    margin-bottom: 5px;
    color: var(--ink);
    max-width: 260px;
    font-size: clamp(1.55rem, 2.6vw, 2.2rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .book-identity {
    color: inherit;
    text-decoration: none;
  }

  .book-identity:hover {
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-underline-offset: 4px;
  }

  .book-stats {
    margin: 0 0 10px;
    color: var(--ink);
    font-size: 0.84rem;
