---
import VersionTwoPage from './_v2.astro';
import VersionThreePage from './_v3.astro';
import VersionFourPage from './_v4.astro';
import VersionFivePage from './_v5.astro';
import VersionSixPage from './_v6.astro';
import VersionSevenPage from './_v7.astro';
import VersionEightPage from './_v8.astro';
import VersionNinePage from './_v9.astro';
import VersionTenPage from './_v10.astro';
import VersionElevenPage from './_v11.astro';

/**
 * Astro treats files whose name begins with an underscore as components rather
 * than routes. Keep the versioned page private as a component and publish only
 * these explicit, static preview paths.
 */
export function getStaticPaths() {
  return ['_v2', '_v3', '_v4', '_v5', '_v6', '_v7', '_v8', '_v9', '_v10', '_v11'].map((slug) => ({ params: { slug } }));
}

const pages = {
  _v2: VersionTwoPage,
  _v3: VersionThreePage,
  _v4: VersionFourPage,
  _v5: VersionFivePage,
  _v6: VersionSixPage,
  _v7: VersionSevenPage,
  _v8: VersionEightPage,
  _v9: VersionNinePage,
  _v10: VersionTenPage,
  _v11: VersionElevenPage,
};
const Page = pages[Astro.params.slug as keyof typeof pages];
---

<Page />
