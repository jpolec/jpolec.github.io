---
import VersionTwoPage from './_v2.astro';
import VersionThreePage from './_v3.astro';
import VersionFourPage from './_v4.astro';

/**
 * Astro treats files whose name begins with an underscore as components rather
 * than routes. Keep the versioned page private as a component and publish only
 * these explicit, static preview paths.
 */
export function getStaticPaths() {
  return ['_v2', '_v3', '_v4'].map((slug) => ({ params: { slug } }));
}

const Page = Astro.params.slug === '_v4'
  ? VersionFourPage
  : Astro.params.slug === '_v3' ? VersionThreePage : VersionTwoPage;
---

<Page />
