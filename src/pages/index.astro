  {
    label: 'LinkedIn',
    href: 'https://linkedin.com/in/jakubpolec',
    count: '30K+',
    detail: 'followers',
    icon: 'linkedin',
  },
  {
    label: 'X / Twitter',
    href: 'https://twitter.com/jakubpolec',
    count: '3.5K+',
    detail: 'followers',
    icon: 'x',
  },
  {
    label: 'GitHub',
    href: 'https://github.com/jpolec',
    count: '100+',
    detail: 'followers',
    icon: 'github',
  },
  {
    label: 'Medium',
    href: 'https://medium.com/@jpolec_72972',
    count: '1.25K+',
    detail: 'followers',
    icon: 'medium',
  },
  {
