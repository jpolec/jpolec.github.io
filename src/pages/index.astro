---
import SimpleLayout from '../layouts/SimpleLayout.astro';
import { profilePageStructuredData } from '../data/profile';
import { services } from '../data/v15-services';

const products = [
  {
    name: 'OneBook',
    destination: 'onebook.quantjourney.cloud',
    description: 'A buy-side investment operating layer connecting research, portfolio state, risk, decisions, and execution.',
    href: 'https://onebook.quantjourney.cloud/',
    action: 'Open OneBook',
    external: true,
  },
  {
    name: 'Quant API / MCP',
    destination: 'api.quantjourney.cloud',
    description: 'Managed financial-data infrastructure with governed routes, normalized contracts, and approved MCP access.',
    href: 'https://api.quantjourney.cloud',
    action: 'Open Quant API / MCP',
    external: true,
  },
  {
    name: 'Backtester',
    destination: 'backtester.quantjourney.cloud',
    description: 'Python-native strategy research with reproducible workflows, diagnostics, and reviewable outputs.',
    href: 'https://backtester.quantjourney.cloud',
    action: 'Open Backtester',
    external: true,
  },
  {
    name: 'Quant Infra',
    destination: 'quantjourney.cloud',
    description: 'Proprietary infrastructure design and delivery for hedge funds, other investment funds, family offices, and investment teams.',
    href: 'https://quantjourney.cloud',
    action: 'Open Quant Infra',
    external: true,
  },
  {
    name: 'Agents',
    destination: 'agents.quantjourney.cloud',
    description: 'Controlled tools for approved financial and investment workflows, with OAuth, scoped access, and MCP.',
    href: 'https://agents.quantjourney.cloud',
    action: 'Open Agents',
    external: true,
  },
];

// Curated for investment teams; titles and topics checked against the public
// article pages. These are editorial selections, not a popularity ranking.
const selectedPosts = [
  {
    "title": "Designing a Real Portfolio Management System",
    "description": "PMS design: keeping positions and cash consistent, with portfolio state that can be rebuilt day by day.",
    "href": "https://quantjourney.substack.com/p/designing-a-real-portfolio-management"
  },
  {
    "title": "QuantJourney Backtester Is Now Open Source",
    "description": "Backtest reliability: tracing when information becomes tradable, how signals become positions, and which execution, cost and validation assumptions shape the results.",
    "href": "https://quantjourney.substack.com/p/quantjourney-backtester-is-now-open"
  },
  {
    "title": "Moving Beyond Correlation - Hunting Alpha with Lead-Lag & Granger Causality",
    "description": "Alpha research: distinguishing statistical lead-lag relationships from an economic edge, and examining how those relationships change across market regimes.",
    "href": "https://quantjourney.substack.com/p/moving-beyond-correlation-hunting"
  },
  {
    "title": "AI-Agent-Native Investment Infrastructure: MCP Access to IBOR, PMS, Risk and Research",
    "description": "Applied AI: connecting agents to controlled portfolio, market-data, risk and research infrastructure through MCP.",
    "href": "https://quantjourney.substack.com/p/ai-agent-native-investment-infrastructure"
  }
];



---

<SimpleLayout
  title="Jakub Połeć - independent review of quantitative systems"
  description="Independent review of quantitative research, investment infrastructure, and technology for hedge funds, family offices, and investors in investment technology."
  ogTitle="Jakub Połeć"
  ogImage="https://jakubpolec.com/og-v15.png"
  ogImageAlt="Jakub Połeć. Independent review of quantitative systems. Research, investment infrastructure and technology."
  ogImageWidth={1200}
  ogImageHeight={630}
  canonical="https://jakubpolec.com/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(profilePageStructuredData)}></script>
  </Fragment>
  <main class="page-shell">
    <section class="hero" aria-labelledby="hero-title">
      <figure class="hero-image-wrap">
        <img
          src="/jakub-polec-seated.webp"
          alt="Portrait of Jakub Połeć"
          class="hero-image"
          width="600"
          height="750"
          loading="eager"
          decoding="async"
        />
      </figure>

      <div class="hero-copy">
        <h1 id="hero-title" >Jakub Połeć</h1>
        <p class="lead">I review and design quantitative systems, investment infrastructure, and the research behind them - and put the answer in writing.</p>
        <div class="hero-about">
          <p>I work with hedge funds, family offices, asset managers, and investors in investment technology. My background is high-energy physics at CERN, followed by Microsoft and Oracle, and more than a decade building data-intensive, AI and quantitative systems. I co-founded and led three technology startups, raised VC funding, and completed one exit. I now run QuantJourney, which builds investment infrastructure for buy-side teams.</p>
          <p>I do not manage client capital and do not give investment advice.</p>
          <p>Based in Dubai, UAE.</p>
        </div>
        <div class="action-row hero-actions" aria-label="Contact links">
          <a href="https://calendly.com/jpolec/30min" class="button primary" target="_blank" rel="noopener">Book a 30-minute call</a>
          <!--email_off--><a href="mailto:jakub@quantjourney.pro" class="button secondary">Email me</a><!--/email_off-->
        </div>
        <div class="social-row" aria-label="Social profiles">
            <a
              href="https://linkedin.com/in/jakubpolec"
              class="social-icon"
              target="_blank"
              rel="noopener"
              aria-label="LinkedIn profile"
              title="LinkedIn"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M6.94 8.5A1.72 1.72 0 1 0 6.94 5.06a1.72 1.72 0 0 0 0 3.44ZM5.48 18.94h2.93V10H5.48v8.94ZM10.25 10v8.94h2.92v-4.42c0-1.17.22-2.3 1.67-2.3 1.43 0 1.45 1.34 1.45 2.38v4.34h2.93v-4.93c0-2.42-.52-4.28-3.35-4.28-1.36 0-2.27.74-2.64 1.45h-.04V10h-2.94Z" />
              </svg>
            </a>
            <a
              href="https://x.com/jakubpolec"
              class="social-icon"
              target="_blank"
              rel="noopener"
              aria-label="X profile"
              title="X"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M18.9 2.25h3.68l-8.04 9.19L24 21.75h-7.41l-5.8-7.59-6.64 7.59H.46l8.6-9.83L0 2.25h7.6l5.24 6.93 6.06-6.93Zm-1.29 17.3h2.04L6.49 4.34H4.3L17.61 19.55Z" />
              </svg>
            </a>
            <a
              href="https://github.com/jpolec"
              class="social-icon"
              target="_blank"
              rel="noopener"
              aria-label="GitHub profile"
              title="GitHub"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12 .297C5.37.297 0 5.67 0 12.297c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.043-1.61-4.043-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.729.083-.729 1.205.084 1.838 1.237 1.838 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.305-5.466-1.334-5.466-5.93 0-1.31.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23a11.52 11.52 0 0 1 3.003-.404c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.652.242 2.873.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.806 5.621-5.479 5.918.43.372.823 1.102.823 2.222 0 1.606-.015 2.898-.015 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.595 24 12.297c0-6.627-5.373-12-12-12" />
              </svg>
            </a>
            <a
              href="https://quantjourney.substack.com"
              class="social-icon"
              target="_blank"
              rel="noopener"
              aria-label="QuantJourney on Substack"
              title="Substack"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M22.539 8.242H1.46V5.406h21.08zM1.46 10.813V24L12 18.11 22.54 24V10.813zM22.54 0H1.46v2.836h21.08z" />
              </svg>
            </a>
        </div>
      </div>
    </section>

    <section class="situations-section" aria-labelledby="situations-title">
      <div class="build-heading"><h2 id="situations-title">When people call me</h2></div>
      <div class="situations">
        <p>Someone claims a system works, and the decision depends on whether that is true.</p>
        <p>A strategy is about to receive capital, and nobody in the room has independently checked the research behind it.</p>
        <p>Research, data, portfolio, risk, and execution have grown into something nobody can trace end to end, and a decision has to be made about what to build, buy, or replace.</p>
      </div>
    </section>

    <section class="personal-section" aria-labelledby="personal-title">
      <h2 id="personal-title">Personal side</h2>
      <ul class="personal-interests" aria-label="Personal interests">
        <li>Padel</li>
        <li>Diving</li>
        <li>Action movies</li>
        <li>Puzzles</li>
        <li>Foodie</li>
        <li>Travel</li>
        <li><button type="button" class="cocker-trigger" aria-haspopup="dialog" aria-controls="cocker-dialog">My cocker spaniel</button></li>
      </ul>
    </section>

    <section id="work-with-me" class="engagement-section" aria-labelledby="engagement-title">
      <div class="build-heading">
        <h2 id="engagement-title">Work with me</h2>
        <p>I take a small number of engagements at a time. Each one is fixed-scope, written up, and delivered on a date agreed in advance.</p>
        <p>Over the past three years, my work has included engagements with 3 hedge funds, 2 family offices and 2 insurers across the US, India, Japan and the Middle East.</p>
      </div>
      <div class="build-list">
        {services.map((service) => (
          <article class="build-item service-row">
            <div class="build-name"><h3>{service.title}</h3></div>
            <div class="service-copy">
              <p class="build-summary">{service.description}</p>
              <p class="build-summary">{service.deliverable}</p>
              <p class="scope-line">Scope: {service.duration}. Fixed fee from {service.fee} USD. Final scope and fee agreed after a 30-minute scoping call. {service.note}</p>
              <a class="scope-link" href={`/services/${service.slug}/`}>Full scope <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="what-i-build" class="build-section" aria-labelledby="working-title">
      <div class="build-heading">
        <h2 id="working-title">What I build</h2>
        <p>QuantJourney is my company. We build and operate the investment systems shown below and have served 100+ paying customers across our API and investment infrastructure products.</p>
      </div>
      <div class="build-list">
        {products.map((product) => (
          <article class="build-item">
            <div class="build-name">
              <a
                class="build-identity"
                href={product.href}
                target={product.external ? '_blank' : undefined}
                rel={product.external ? 'noopener' : undefined}
              >
                <h3>{product.name}</h3>
                <span class="build-destination">{product.destination}</span>
              </a>
            </div>
            <p class="build-summary">{product.description}</p>
            <div class="build-action">
              <a
                href={product.href}
                target={product.external ? '_blank' : undefined}
                rel={product.external ? 'noopener' : undefined}
              >
                {product.action} <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="links-section" aria-labelledby="book-title">
      <div class="book-feature">
        <div class="book-overview">
          <div class="book-heading">
            <h2 id="book-title">
              <a
                class="book-identity"
                href="https://quant-interviews.quantjourney.cloud"
                target="_blank"
                rel="noopener"
              >
                My book
              </a>
            </h2>
          </div>
          <div class="book-copy">
            <p class="book-stats">1,630 pages · 194 questions · Python/C++/SQL</p>
            <p>
              From mathematical foundations to production-grade quant systems.
            </p>
          </div>
          <div class="build-action book-action">
            <a
              href="https://quant-interviews.quantjourney.cloud"
              target="_blank"
              rel="noopener"
            >
              Open Quant Interviews <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div class="book-volume-grid" aria-label="Quant Interviews volumes">
          <article class="book-volume-card">
            <img
              src="/quant-interviews-volume-1.svg"
              alt="Quant Interviews Volume I cover"
              width="540"
              height="763"
              loading="lazy"
              decoding="async"
            />
            <div class="book-volume-copy">
              <span class="book-volume-label">Volume I</span>
              <span class="book-volume-title">Mathematical Foundations</span>
            </div>
          </article>
          <article class="book-volume-card">
            <img
              src="/quant-interviews-volume-2.svg"
              alt="Quant Interviews Volume II cover"
              width="540"
              height="763"
              loading="lazy"
              decoding="async"
            />
            <div class="book-volume-copy">
              <span class="book-volume-label">Volume II</span>
              <span class="book-volume-title">Production-Grade Quant Systems</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="articles-section" aria-labelledby="articles-title">
      <div class="build-heading">
        <h2 id="articles-title">Selected Research</h2>
        <p>On the QuantJourney blog, I have published 250+ articles covering investment strategies, alpha research, backtesting, portfolio construction, risk, data engineering, execution and applied AI.</p>
      </div>
      <div class="build-list">
        {selectedPosts.map((post) => (
          <article class="build-item">
            <div class="build-name">
              <a class="build-identity" href={post.href} target="_blank" rel="noopener">
                <h3>{post.title}</h3>
                <span class="build-destination">quantjourney.substack.com</span>
              </a>
            </div>
            <p class="build-summary">{post.description}</p>
            <div class="build-action">
              <a href={post.href} target="_blank" rel="noopener" aria-label={`Read ${post.title}`}>
                Read article <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
      <p class="article-note"><a href="https://quantjourney.substack.com" target="_blank" rel="noopener">More on the QuantJourney blog <span aria-hidden="true">↗</span></a></p>
      <div class="closing-contact">
        <p>Bring the decision you are facing and whatever material you have. In thirty minutes I will tell you whether I can help, what it would take, and what it would cost.</p>
        <div class="action-row" aria-label="Discuss your decision">
          <a href="https://calendly.com/jpolec/30min" class="button primary" target="_blank" rel="noopener">Book a 30-minute call</a>
          <!--email_off--><a href="mailto:jakub@quantjourney.pro" class="button secondary">Email me</a><!--/email_off-->
        </div>
      </div>
    </section>


  </main>

  <dialog id="cocker-dialog" class="cocker-dialog" aria-label="My cocker spaniel">
    <button type="button" class="cocker-dialog-close" aria-label="Close photo">&times;</button>
    <figure>
      <img
        src="/cocker-spaniel.webp"
        alt="Jakub's black cocker spaniel resting on a sofa"
        width="1200"
        height="1600"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </dialog>

  <script>
    const cockerDialog = document.querySelector<HTMLDialogElement>('#cocker-dialog');
    const cockerTrigger = document.querySelector<HTMLButtonElement>('.cocker-trigger');
    const cockerClose = document.querySelector<HTMLButtonElement>('.cocker-dialog-close');

    if (cockerDialog && cockerTrigger && cockerClose) {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let closeTimer: number | undefined;

      const finishClose = () => {
        window.clearTimeout(closeTimer);
        cockerDialog.close();
        cockerDialog.classList.remove('is-closing');
      };

      const closeDialog = () => {
        if (!cockerDialog.open || cockerDialog.classList.contains('is-closing')) return;

        if (reducedMotion.matches) {
          finishClose();
          return;
        }

        cockerDialog.classList.add('is-closing');
        closeTimer = window.setTimeout(finishClose, 180);
      };

      cockerTrigger.addEventListener('click', () => {
        window.clearTimeout(closeTimer);
        cockerDialog.classList.remove('is-closing');
        cockerDialog.showModal();
        document.documentElement.classList.add('dialog-open');
      });

      cockerClose.addEventListener('click', closeDialog);
      cockerDialog.addEventListener('cancel', (event) => {
        event.preventDefault();
        closeDialog();
      });
      cockerDialog.addEventListener('click', (event) => {
        if (event.target === cockerDialog) closeDialog();
      });
      cockerDialog.addEventListener('close', () => {
        window.clearTimeout(closeTimer);
        cockerDialog.classList.remove('is-closing');
        document.documentElement.classList.remove('dialog-open');
      });
    }
  </script>
</SimpleLayout>



<style>
  .page-shell {
    width: min(1080px, calc(100% - 40px));
    margin: 0 auto;
    padding: 42px 0 100px;
    font-family: inherit;
  }

  /* ── Hero ── */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(240px, 300px) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
    min-height: auto;
    padding: 28px 0 24px;
  }

  .hero-image-wrap {
    position: relative;
    z-index: 1;
    overflow: hidden;
    isolation: isolate;
    margin: 30px 0 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--ink);
  }

  .hero-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1) contrast(1.04);
    mix-blend-mode: screen;
  }

  .hero-image-wrap figcaption {
    margin: 0;
    padding: 8px 2px 0;
    color: var(--muted);
    font-size: 0.68rem;
    line-height: 1.4;
    text-align: center;
  }

  .hero-copy {
    position: relative;
    top: 0;
    z-index: 1;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 14px;
    color: var(--ink);
    font-size: clamp(2.35rem, 5vw, 4.4rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .role {
    margin-bottom: 12px;
    color: var(--ink);
    font-size: clamp(1.05rem, 1.75vw, 1.28rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }

  .founder-line {
    margin-bottom: 22px;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.45;
  }

  .founder-line a {
    font-weight: 600;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }

  .lead {
    margin-bottom: 24px;
    color: var(--muted);
    font-size: clamp(0.94rem, 1.18vw, 1rem);
    line-height: 1.62;
  }

  .hero-about p {
    margin: 0 0 11px;
    color: var(--muted);
    font-size: clamp(0.94rem, 1.18vw, 1rem);
    line-height: 1.62;
  }

  .hero-about p:last-child {
    margin-bottom: 0;
  }

  .social-icon svg {
    width: 17px;
    height: 17px;
    fill: currentColor;
  }

  .action-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--ink);
    border-radius: 8px;
    padding: 13px 18px;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.1;
    text-decoration: none;
    transition: background 160ms ease, color 160ms ease, border-color 160ms ease,
      transform 150ms ease, box-shadow 160ms ease;
  }

  .button:hover {
    background: var(--ink);
    color: var(--page-bg);
    border-color: var(--ink);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.16);
  }

  .button:active {
    transform: translateY(0);
  }

  .button.primary {
    background: var(--ink);
    color: var(--page-bg);
  }

  .button.secondary {
    background: var(--page-bg);
    color: var(--ink);
  }

  .button.secondary:hover {
    background: var(--ink);
    color: var(--page-bg);
  }

  .button.primary:hover {
    background: var(--ink);
    color: var(--page-bg);
    border-color: var(--ink);
  }

  .engagement-section {
    margin-top: 26px;
    padding: 26px 0 4px;
  }

  .personal-section {
    display: grid;
    grid-template-columns: minmax(190px, 0.68fr) minmax(0, 2.33fr);
    gap: 28px;
    align-items: center;
    margin-top: 34px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .personal-section h2 {
    margin: 0;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .personal-interests {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 0;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--ink);
    font-size: clamp(0.8rem, 1.2vw, 0.92rem);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  .personal-interests li {
    display: inline-flex;
    align-items: center;
  }

  .personal-interests li + li::before {
    margin: 0 10px;
    color: var(--muted);
    content: '/';
    font-weight: 400;
  }

  .cocker-trigger {
    border: 0;
    padding: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }

  .cocker-trigger:hover,
  .cocker-trigger:focus-visible {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  :global(html.dialog-open) {
    overflow: hidden;
  }

  .cocker-dialog {
    max-width: min(760px, calc(100vw - 32px));
    max-height: calc(100vh - 32px);
    overflow: visible;
    border: 0;
    border-radius: 12px;
    padding: 0;
    background: transparent;
    opacity: 0;
    transform: translateY(12px) scale(0.97);
  }

  .cocker-dialog[open] {
    animation: cocker-dialog-in 220ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  .cocker-dialog.is-closing {
    animation: cocker-dialog-out 180ms ease forwards;
  }

  .cocker-dialog::backdrop {
    background: rgba(4, 24, 48, 0.76);
    backdrop-filter: blur(5px);
    animation: cocker-backdrop-in 220ms ease both;
