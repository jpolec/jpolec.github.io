    color: var(--ink);
    font-size: clamp(2.35rem, 5vw, 4.4rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .role {
    margin-bottom: 5px;
    color: var(--ink);
    font-size: clamp(1.05rem, 1.75vw, 1.28rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }

  .founder-line {
    margin-bottom: 22px;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.45;
  }

  .founder-line a {
    font-weight: 600;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }

  .lead {
    max-width: 560px;
    margin-bottom: 24px;
    color: var(--muted);
    font-size: clamp(0.98rem, 1.45vw, 1.12rem);
    line-height: 1.58;
  }

  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 9px;
    margin: 0;
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.5;
