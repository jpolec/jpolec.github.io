---
import SimpleLayout from '../layouts/SimpleLayout.astro';
import { personStructuredData, profile } from '../data/profile';

const products = [
  {
    name: 'OneBook',
    destination: 'onebook.quantjourney.cloud',
    description: 'A buy-side investment operating layer connecting research, portfolio state, risk, decisions, and execution.',
    href: 'https://onebook.quantjourney.cloud/_vv7/',
    action: 'Open OneBook',
    external: true,
  },
  {
    name: 'Quant API / MCP',
    destination: 'api.quantjourney.cloud',
    description: 'Managed financial-data infrastructure with governed routes, normalized contracts, and approved MCP access.',
    href: 'https://api.quantjourney.cloud',
    action: 'Open Quant API / MCP',
    external: true,
  },
  {
    name: 'Data Workspace',
    destination: 'data.quantjourney.cloud',
    description: 'A financial-data workspace for approved market, fundamentals, portfolio, and analytical workflows.',
    href: 'https://data.quantjourney.cloud',
    action: 'Open Data Workspace',
    external: true,
  },
  {
    name: 'Backtester',
    destination: 'backtester.quantjourney.cloud',
    description: 'Python-native strategy research with reproducible workflows, diagnostics, and reviewable outputs.',
    href: 'https://backtester.quantjourney.cloud',
    action: 'Open Backtester',
    external: true,
  },
  {
    name: 'Quant Infra',
    destination: 'quantjourney.cloud',
    description: 'Proprietary infrastructure design and delivery for hedge funds, other investment funds, family offices, and investment teams.',
    href: 'https://quantjourney.cloud',
    action: 'Open Quant Infra',
    external: true,
  },
  {
    name: 'Agents',
    destination: 'agents.quantjourney.cloud',
    description: 'Controlled tools for approved financial and investment workflows, with OAuth, scoped access, and MCP.',
    href: 'https://agents.quantjourney.cloud',
    action: 'Open Agents',
    external: true,
  },
];

const publicResearch = [
  {
    name: 'Quant Blog',
    destination: 'quantjourney.substack.com',
    description: 'Long-form writing on quantitative research, markets, investment infrastructure, and applied AI.',
    href: 'https://quantjourney.substack.com',
    action: 'Open Quant Blog',
  },
  {
    name: 'GitHub',
    destination: 'github.com/jpolec',
    description: 'Public repositories, working examples, and release history behind my quant and infrastructure work.',
    href: 'https://github.com/jpolec',
    action: 'Open GitHub',
  },
];
---

<SimpleLayout
  title={profile.name}
  description={profile.description}
  canonical={profile.canonicalUrl}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personStructuredData)}></script>
  </Fragment>
  <main class="page-shell">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-bg" aria-hidden="true"></div>

      <figure class="hero-image-wrap animate-in">
        <img
          src="/jpbg.jpeg"
          alt="Jakub Polec with Bill Gates during his Microsoft years"
          class="hero-image"
          width="440"
          height="550"
          loading="eager"
          decoding="async"
        />
        <figcaption>With Bill Gates, during my Microsoft years.</figcaption>
      </figure>

      <div class="hero-copy">
        <h1 id="hero-title" class="animate-in">{profile.name}</h1>
        <p class="role animate-in">{profile.role}</p>
        <p class="lead animate-in">
          I invest proprietary capital independently and build institutional-grade research,
          data, portfolio, risk, and AI infrastructure for hedge funds, other investment funds,
          family offices, and investment teams.
        </p>

        <div class="hero-about animate-in">
          <p>
            I am the founder of {profile.organisation.name}, based in {profile.location}.
            QuantJourney is a technology business: it does not manage client assets or provide
            investment advice.
          </p>
          <p>
            My background spans high-energy physics, Microsoft, technology entrepreneurship,
            Oracle, and quantitative finance. I have led technology and innovation teams across
            Europe and the Middle East, including as {profile.career.oracleTitle} at Oracle.
          </p>
          <p>
            I have built {profile.career.startups} and received
            {` ${profile.career.microsoftAwards}`}.
          </p>
        </div>

        <p class="hero-proof animate-in">
          Microsoft
          <span aria-hidden="true">·</span> Oracle
          <span aria-hidden="true">·</span> Quantitative Finance
          <span aria-hidden="true">·</span> Investment Infrastructure
        </p>

        <div class="action-row hero-actions animate-in" aria-label="Contact links">
          <a
            href="https://calendly.com/jpolec/30min"
            class="button primary"
            target="_blank"
            rel="noopener"
          >
            Set up a meeting
          </a>
          <a href="mailto:jakub@quantjourney.pro" class="button primary">
            Email me
          </a>
          <a
            href="https://linkedin.com/in/jakubpolec"
            class="button primary"
            target="_blank"
            rel="noopener"
          >
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <section id="what-i-build" class="build-section animate-in" aria-labelledby="working-title">
      <div class="build-heading">
        <h2 id="working-title">What I build</h2>
        <p>
          Products and proprietary infrastructure for research, portfolio workflows, data, and
          controlled AI access.
        </p>
      </div>
      <div class="build-list">
        {products.map((product) => (
          <article class="build-item">
            <div class="build-name">
              <h3>{product.name}</h3>
              <span class="build-destination">{product.destination}</span>
            </div>
            <p class="build-summary">{product.description}</p>
            <div class="build-action">
              <a
                href={product.href}
                target={product.external ? '_blank' : undefined}
                rel={product.external ? 'noopener' : undefined}
              >
                {product.action} <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="links-section animate-in" aria-labelledby="book-title">
      <div class="book-feature">
        <div class="book-overview">
          <div class="book-heading">
            <h2 id="book-title">Book Quant Interviews</h2>
          </div>
          <div class="book-copy">
            <p class="book-stats">1,600+ pages · 190+ problems · Python/C++/SQL</p>
            <p>
              From mathematical foundations to production-grade quant systems.
            </p>
          </div>
          <div class="build-action book-action">
            <a
              href="https://quant-interviews.quantjourney.cloud"
              target="_blank"
              rel="noopener"
            >
              Open Quant Interviews <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div class="book-volume-grid" aria-label="Quant Interviews volumes">
          <article class="book-volume-card">
            <img
              src="/quant-interviews-cover.webp"
              alt="Quant Interviews Volume I cover"
              width="540"
              height="763"
              loading="lazy"
              decoding="async"
            />
            <div class="book-volume-copy">
              <span class="book-volume-label">Volume I</span>
              <span class="book-volume-title">Mathematical Foundations</span>
            </div>
          </article>
          <article class="book-volume-card">
            <img
              src="/quant-interviews-cover.webp"
              alt="Quant Interviews Volume II cover"
              width="540"
              height="763"
              loading="lazy"
              decoding="async"
            />
            <div class="book-volume-copy">
              <span class="book-volume-label">Volume II</span>
              <span class="book-volume-title">Production-Grade Quant Systems</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="research-section animate-in" aria-labelledby="research-title">
      <div class="build-heading">
        <h2 id="research-title">Public research</h2>
        <p>Writing and public code for quantitative practitioners, researchers, and developers.</p>
      </div>
      <div class="build-list">
        {publicResearch.map((resource) => (
          <article class="build-item">
            <div class="build-name">
              <h3>{resource.name}</h3>
              <span class="build-destination">{resource.destination}</span>
            </div>
            <p class="build-summary">{resource.description}</p>
            <div class="build-action">
              <a href={resource.href} target="_blank" rel="noopener">
                {resource.action} <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="content-section work-section animate-in" aria-labelledby="collaborate-title">
      <div>
        <h2 id="collaborate-title">Work with me</h2>
      </div>
      <div class="section-copy">
        <p>
          I work selectively with hedge funds, other investment funds, family offices, and
          investment teams on institutional-grade infrastructure, strategy research, and
          independent technical review.
        </p>
        <div class="item-stack opportunity-list">
          <article class="text-item">
            <h3>Quant Infra engagements</h3>
            <p>
              Architecture and delivery for proprietary research, data, IBOR/PMS, risk, OMS,
              and AI systems in real investment operating workflows.
            </p>
          </article>
          <article class="text-item">
            <h3>Architecture &amp; technical due diligence</h3>
            <p>
              Platform design, system reviews, and technology strategy for funds,
              family offices, and investment-technology companies.
            </p>
          </article>
          <article class="text-item">
            <h3>Strategy &amp; backtest consulting</h3>
            <p>
              Research design, point-in-time data review, backtest validation, portfolio
              construction, and execution-cost assumptions.
            </p>
          </article>
        </div>
        <div class="action-row" aria-label="Work with me contact links">
          <a
            href="https://calendly.com/jpolec/30min"
            class="button primary"
            target="_blank"
            rel="noopener"
          >
            Set up a meeting
          </a>
          <a href="mailto:jakub@quantjourney.pro" class="button primary">
            Email me
          </a>
        </div>
      </div>
    </section>

  </main>
</SimpleLayout>

<script>
  // Scroll-triggered fade-in animations
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );

    document.querySelectorAll('.animate-in').forEach((el) =>
      observer.observe(el)
    );
  } else {
    document
      .querySelectorAll('.animate-in')
      .forEach((el) => el.classList.add('visible'));
  }
</script>

<style>
  .page-shell {
    width: min(1080px, calc(100% - 40px));
    margin: 0 auto;
    padding: 42px 0 100px;
  }

  /* ── Hero ── */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(280px, 440px) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
    min-height: auto;
    padding: 28px 0 24px;
  }

  .hero-bg {
    position: absolute;
    top: -20%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, var(--glow) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-image-wrap {
    position: relative;
    z-index: 1;
    margin: 0;
  }

  .hero-image {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .hero-image-wrap figcaption {
    margin: 0;
    padding: 8px 2px 0;
    color: var(--muted);
    font-size: 0.68rem;
    line-height: 1.4;
    text-align: center;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    max-width: 620px;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 14px;
    color: var(--ink);
    font-size: clamp(2.35rem, 5vw, 4.4rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .role {
    margin-bottom: 5px;
    color: var(--ink);
    font-size: clamp(1.05rem, 1.75vw, 1.28rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }

  .founder-line {
    margin-bottom: 22px;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.45;
  }

  .founder-line a {
    font-weight: 600;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }

  .lead {
    max-width: 560px;
    margin-bottom: 24px;
    color: var(--muted);
    font-size: clamp(0.98rem, 1.45vw, 1.12rem);
    line-height: 1.58;
  }

  .hero-about {
    max-width: 590px;
  }

  .hero-about p {
    margin: 0 0 11px;
    color: var(--muted);
    font-size: clamp(0.88rem, 1.12vw, 0.96rem);
    line-height: 1.58;
  }

  .hero-about p:last-child {
    margin-bottom: 0;
  }

  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 9px;
    margin: 22px 0 0;
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.025em;
  }

  .hero-actions {
    margin-top: 18px;
  }

  .hero-actions .button {
    min-height: 42px;
    padding: 11px 15px;
    font-size: 0.8rem;
  }

  .action-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--ink);
    border-radius: 8px;
    padding: 13px 18px;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.1;
    text-decoration: none;
    transition: background 160ms ease, color 160ms ease, border-color 160ms ease,
      transform 150ms ease, box-shadow 160ms ease;
  }

  .button:hover {
    background: var(--ink);
    color: var(--page-bg);
    border-color: var(--ink);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.16);
  }

  .button:active {
    transform: translateY(0);
  }

  .button.primary {
    background: transparent;
    color: var(--ink);
  }

  .button.primary:hover {
    background: var(--ink);
    color: var(--page-bg);
    border-color: var(--ink);
  }

  /* ── What I build ── */
  .build-section {
    margin-top: 38px;
    padding: 38px 0 4px;
    border-top: 1px solid var(--line);
  }

  .research-section {
    margin-top: 38px;
    padding: 38px 0 4px;
    border-top: 1px solid var(--line);
  }

  .build-heading {
    max-width: 790px;
    margin-bottom: 28px;
  }

  .build-heading h2 {
    margin: 0 0 10px;
    color: var(--ink);
    font-size: clamp(1.55rem, 2.6vw, 2.2rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .build-heading p {
    margin: 0;
    color: var(--muted);
    font-size: clamp(0.94rem, 1.18vw, 1rem);
    line-height: 1.62;
  }

  .build-list {
    border-top: 1px solid var(--line);
  }

  .build-section .build-list,
  .research-section .build-list {
    border-top: 0;
  }

  .build-item {
    display: grid;
    grid-template-columns: minmax(190px, 0.68fr) minmax(0, 1.85fr) minmax(135px, 0.48fr);
    gap: 28px;
    align-items: start;
    padding: 29px 0 30px;
    border-bottom: 1px solid var(--line);
  }

  .build-name {
    display: grid;
    gap: 10px;
  }

  .build-name h3 {
    margin: 0;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .build-destination {
    color: var(--ink);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.72rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .build-summary {
    margin: 0;
    color: var(--ink);
    font-size: 0.96rem;
    font-weight: 600;
    line-height: 1.58;
  }

  .build-action {
    padding-top: 1px;
  }

  .build-action a {
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 750;
    line-height: 1.45;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: border-color 160ms ease;
  }

  .build-action a:hover {
    border-color: var(--ink);
  }

  /* ── Content sections ── */
  .content-section {
    display: grid;
    grid-template-columns: minmax(190px, 0.7fr) minmax(0, 1.43fr);
    gap: clamp(24px, 6vw, 90px);
    margin-top: 38px;
    padding: 38px 0 4px;
    border-top: 1px solid var(--line);
  }

  .content-section h2 {
    max-width: 260px;
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.55rem, 2.6vw, 2.2rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .work-section {
    border-top: 0;
  }

  .section-copy {
    max-width: 715px;
  }

  .section-copy > p,
  .text-item p {
    margin: 0 0 14px;
    color: var(--muted);
    font-size: clamp(0.94rem, 1.18vw, 1rem);
    line-height: 1.62;
  }

  .item-stack {
    display: grid;
    gap: 26px;
  }

  .text-item h3 {
    margin-bottom: 8px;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .text-item p:last-child {
    margin-bottom: 0;
  }

  .opportunity-list {
    margin-top: 26px;
  }

  /* ── Links Section ── */
  .links-section {
    margin-top: 38px;
    padding: 38px 0 12px;
  }

  .book-feature {
    margin-bottom: 38px;
  }

  .book-overview {
    display: grid;
    grid-template-columns: minmax(190px, 0.68fr) minmax(0, 1.85fr) minmax(135px, 0.48fr);
    gap: 28px;
  }

  .book-kicker {
    margin: 0 0 10px;
    color: var(--muted);
    font-size: clamp(0.94rem, 1.18vw, 1rem);
    font-weight: 400;
    line-height: 1.62;
    letter-spacing: normal;
  }

  .book-heading h2 {
    margin-bottom: 5px;
    color: var(--ink);
    max-width: 260px;
    font-size: clamp(1.55rem, 2.6vw, 2.2rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .book-stats {
    margin: 0 0 10px;
    color: var(--ink);
    font-size: 0.84rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .book-copy > p:not(.book-kicker):not(.book-stats) {
    max-width: 715px;
    margin-bottom: 14px;
    color: var(--muted);
    font-size: clamp(0.94rem, 1.18vw, 1rem);
    line-height: 1.62;
  }

  .book-volume-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    max-width: 600px;
    margin: 34px auto 20px;
  }

  .book-volume-card {
    display: flex;
    min-height: 0;
    flex-direction: column;
    gap: 16px;
  }

  .book-volume-card img {
    display: block;
    width: min(100%, 220px);
    height: auto;
    margin: 0 auto;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: #ffffff;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.12);
  }

  .book-volume-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 6px;
    text-align: center;
  }

  .book-volume-label {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .book-volume-title {
    color: var(--ink);
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .links-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
  }

  .link-item {
    display: flex;
    min-height: 148px;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    padding: 20px;
    text-decoration: none;
    transition: background 200ms ease, border-color 200ms ease,
      transform 200ms ease, box-shadow 200ms ease;
    cursor: pointer;
  }

  .link-item:hover {
    background: var(--surface-strong);
    border-color: #b9c6d2;
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);
  }

  .link-item:active {
    transform: translateY(-1px);
  }

  .link-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: var(--soft);
    color: var(--ink);
    margin-bottom: 14px;
    transition: background 200ms ease;
  }

  .link-item:hover .link-icon-wrap {
    background: var(--surface-strong);
  }

  .link-text {
    display: flex;
    flex-direction: column;
    margin-top: auto;
  }

  .link-label {
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 600;
    margin-bottom: 6px;
  }

  .link-count {
    color: var(--ink);
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .link-detail {
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  @media (max-width: 860px) {
    .page-shell {
      width: min(100% - 28px, 680px);
      padding-top: 24px;
    }

    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: 88px;
      padding-bottom: 34px;
    }

    .hero-image-wrap {
      display: none;
    }

    .hero-bg {
      width: 400px;
      height: 400px;
      top: -10%;
      right: -20%;
    }

    .content-section {
      grid-template-columns: 1fr;
    }

    .content-section {
      gap: 18px;
