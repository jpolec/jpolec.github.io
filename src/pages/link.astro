---
import SimpleLayout from '../layouts/SimpleLayout.astro';

const linkGroups = [
  {
    label: 'Produkty i publikacje',
    description: 'Główne produkty QuantJourney, narzędzia i materiały publiczne.',
    links: [
      {
        name: 'QuantJourney / OneBook',
        href: 'https://quantjourney.cloud',
        domain: 'quantjourney.cloud',
        description: 'Platforma inwestycyjna i infrastruktura dla zespołów buy-side.',
      },
      {
        name: 'Quant API',
        href: 'https://api.quantjourney.cloud/docs',
        domain: 'api.quantjourney.cloud/docs',
        description: 'Dokumentacja tras API, kontraktów odpowiedzi i integracji.',
      },
      {
        name: 'Data Workspace',
        href: 'https://data.quantjourney.cloud',
        domain: 'data.quantjourney.cloud',
        description: 'Dane, research, portfolio i workflowy analityczne.',
      },
      {
        name: 'Backtester',
        href: 'https://backtester.quantjourney.cloud',
        domain: 'backtester.quantjourney.cloud',
        description: 'Strategie, backtesty i analiza wyników.',
      },
      {
        name: 'Agents',
        href: 'https://agents.quantjourney.cloud',
        domain: 'agents.quantjourney.cloud',
        description: 'Narzędzia agent-native, OAuth i kontrolowany dostęp dla agentów AI.',
      },
      {
        name: 'Quant Interviews',
        href: 'https://quant-interviews.quantjourney.cloud/',
        domain: 'quant-interviews.quantjourney.cloud',
        description: 'Strona i materiały towarzyszące książce Quant Interviews.',
      },
      {
        name: 'Quant Blog',
        href: 'https://quantjourney.substack.com',
        domain: 'quantjourney.substack.com',
        description: 'Eseje, analizy i aktualności QuantJourney na Substacku.',
      },
      {
        name: 'GitHub',
        href: 'https://github.com/jpolec',
        domain: 'github.com/jpolec',
        description: 'Otwarte projekty, release’y i kod rozwijany publicznie.',
      },
    ],
  },
  {
    label: 'Panele operacyjne',
    description: 'Dostęp, obsługa klientów i monitoring infrastruktury.',
    links: [
      {
        name: 'Cockpit',
        href: 'https://cockpit.quantjourney.cloud',
        domain: 'cockpit.quantjourney.cloud',
        description: 'Panel staff: klienci, zgłoszenia, uprawnienia i konfiguracja produktów.',
      },
      {
        name: 'Users',
        href: 'https://users.quantjourney.cloud',
        domain: 'users.quantjourney.cloud',
        description: 'Portal klienta do konta, dostępów i ustawień usług QuantJourney.',
      },
      {
        name: 'Auth',
        href: 'https://auth.quantjourney.cloud',
        domain: 'auth.quantjourney.cloud',
        description: 'Centralne logowanie, rejestracja, reset hasła i zarządzanie sesją.',
      },
      {
        name: 'Grafana',
        href: 'https://grafana.quantjourney.cloud',
        domain: 'grafana.quantjourney.cloud',
        description: 'Monitoring infrastruktury, dashboardy, alerty i metryki.',
      },
      {
        name: 'Kafka Console',
        href: 'https://kafka.quantjourney.cloud',
        domain: 'kafka.quantjourney.cloud',
        description: 'Konsola zdarzeń i inspekcja ruchu Redpanda/Kafka.',
      },
    ],
  },
];
---

<SimpleLayout
  title="Links | Jakub Polec"
  description="Unlisted directory of QuantJourney products and operational tools."
  noindex={true}
>
  <main class="links-page">
    <div class="links-shell">
      <header class="page-header">
        <p class="kicker">PRIVATE LINKS</p>
        <h1>Links</h1>
        <p class="intro">Produkty QuantJourney i panele, których używasz na co dzień.</p>
        <p class="private-note">
          Ta strona nie jest podpięta w nawigacji i ma ustawione <code>noindex</code>.
          Każdy panel zachowuje własne logowanie i ograniczenia dostępu.
        </p>
      </header>

      {linkGroups.map((group) => (
        <section class="link-group" aria-labelledby={`group-${group.label.toLowerCase().replaceAll(' ', '-')}`}>
          <h2 id={`group-${group.label.toLowerCase().replaceAll(' ', '-')}`}>{group.label}</h2>
          <p class="group-intro">{group.description}</p>

          <ul class="link-list">
            {group.links.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer">{link.name}</a>
                <p><span>{link.domain}</span>{' — '}{link.description}</p>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <footer>
        <a href="/">Jakub Polec</a>
      </footer>
    </div>
  </main>
</SimpleLayout>

<style>
  .links-page {
    min-height: 100vh;
    background: var(--page-bg);
    color: var(--ink);
  }

  .links-shell {
    width: min(760px, calc(100% - 40px));
    margin: 0 auto;
    padding: 92px 0 64px;
  }

  .page-header {
    margin-bottom: 66px;
  }

  .kicker {
    margin: 0 0 14px;
    color: var(--accent);
    font-size: 0.73rem;
    font-weight: 800;
    letter-spacing: 0.13em;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 15px;
    color: var(--ink);
    font-size: clamp(2.8rem, 8vw, 4.6rem);
    font-weight: 800;
    letter-spacing: -0.07em;
    line-height: 0.96;
  }

  .intro {
    max-width: 580px;
    margin-bottom: 20px;
    color: var(--muted);
    font-size: 1.12rem;
    line-height: 1.55;
  }

  .private-note {
    max-width: 620px;
    margin: 0;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.83rem;
    line-height: 1.6;
  }

  code {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    color: var(--ink);
    background: var(--soft);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.9em;
  }

  .link-group + .link-group {
    margin-top: 62px;
  }

  h2 {
    margin-bottom: 8px;
    color: var(--ink);
    font-size: clamp(1.55rem, 4vw, 2rem);
    font-weight: 750;
    letter-spacing: -0.045em;
    line-height: 1.15;
  }

  .group-intro {
    margin-bottom: 22px;
    color: var(--muted);
    font-size: 0.96rem;
    line-height: 1.5;
  }

  .link-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .link-list li {
    padding: 19px 0 18px;
    border-bottom: 1px solid var(--line);
  }

  .link-list a {
    color: var(--ink);
    font-size: 1.08rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .link-list a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .link-list a:focus-visible {
    border-radius: 3px;
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .link-list p {
    margin: 7px 0 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .link-list p span {
    color: var(--accent);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8rem;
  }

  footer {
    margin-top: 64px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  footer a {
    color: var(--muted);
    font-size: 0.83rem;
    font-weight: 600;
    text-decoration: none;
  }

  footer a:hover {
    color: var(--accent);
  }

  @media (max-width: 600px) {
    .links-shell {
      width: min(100% - 30px, 760px);
      padding-top: 58px;
    }

    .page-header {
      margin-bottom: 48px;
    }

    .link-group + .link-group {
      margin-top: 48px;
    }

    .link-list li {
      padding: 17px 0;
    }
  }
</style>
