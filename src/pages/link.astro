---
import SimpleLayout from '../layouts/SimpleLayout.astro';

const linkGroups = [
  {
    eyebrow: 'PRODUCTS',
    title: 'Produkty i publikacje',
    description: 'Codzienne punkty wejścia do produktów QuantJourney, narzędzi i materiałów publicznych.',
    links: [
      {
        name: 'QuantJourney / OneBook',
        domain: 'quantjourney.cloud',
        description: 'Strona główna platformy inwestycyjnej i infrastruktury dla zespołów buy-side.',
        href: 'https://quantjourney.cloud',
        mark: 'QJ',
        tone: 'blue',
        access: 'Publiczne',
      },
      {
        name: 'Quant API',
        domain: 'api.quantjourney.cloud/docs',
        description: 'Dokumentacja tras API, kontrakty odpowiedzi i materiały dla integracji.',
        href: 'https://api.quantjourney.cloud/docs',
        mark: 'API',
        tone: 'violet',
        access: 'Publiczne',
      },
      {
        name: 'Data Workspace',
        domain: 'data.quantjourney.cloud',
        description: 'Przestrzeń danych, researchu, portfela i workflowów analitycznych.',
        href: 'https://data.quantjourney.cloud',
        mark: 'DATA',
        tone: 'teal',
        access: 'Logowanie',
      },
      {
        name: 'Backtester',
        domain: 'backtester.quantjourney.cloud',
        description: 'Budowanie, uruchamianie i analiza strategii oraz wyników backtestów.',
        href: 'https://backtester.quantjourney.cloud',
        mark: 'BT',
        tone: 'orange',
        access: 'Logowanie',
      },
      {
        name: 'Agents',
        domain: 'agents.quantjourney.cloud',
        description: 'Warstwa agent-native: narzędzia, OAuth i kontrolowany dostęp dla agentów AI.',
        href: 'https://agents.quantjourney.cloud',
        mark: 'AI',
        tone: 'pink',
        access: 'Publiczne',
      },
      {
        name: 'Quant Interviews',
        domain: 'quant-interviews.quantjourney.cloud',
        description: 'Strona i towarzyszące materiały do książki Quant Interviews.',
        href: 'https://quant-interviews.quantjourney.cloud/',
        mark: 'QI',
        tone: 'gold',
        access: 'Publiczne',
      },
      {
        name: 'Quant Blog',
        domain: 'quantjourney.substack.com',
        description: 'Eseje, analizy i aktualności QuantJourney publikowane na Substacku.',
        href: 'https://quantjourney.substack.com',
        mark: 'QB',
        tone: 'red',
        access: 'Publiczne',
      },
      {
        name: 'GitHub',
        domain: 'github.com/jpolec',
        description: 'Otwarte projekty, release’y i kod rozwijany publicznie.',
        href: 'https://github.com/jpolec',
        mark: 'GH',
        tone: 'slate',
        access: 'Publiczne',
      },
    ],
  },
  {
    eyebrow: 'OPERATIONS',
    title: 'Panele operacyjne',
    description: 'Narzędzia do obsługi klientów, dostępu, monitoringu i komunikacji między usługami.',
    links: [
      {
        name: 'Cockpit',
        domain: 'cockpit.quantjourney.cloud',
        description: 'Staff control plane: klienci, zgłoszenia, uprawnienia i konfiguracja produktów.',
        href: 'https://cockpit.quantjourney.cloud',
        mark: 'CP',
        tone: 'blue',
        access: 'Staff / VPN',
      },
      {
        name: 'Users',
        domain: 'users.quantjourney.cloud',
        description: 'Portal klienta do konta, dostępów i ustawień usług QuantJourney.',
        href: 'https://users.quantjourney.cloud',
        mark: 'US',
        tone: 'teal',
        access: 'Logowanie',
      },
      {
        name: 'Auth',
        domain: 'auth.quantjourney.cloud',
        description: 'Centralne logowanie, rejestracja, reset hasła i zarządzanie sesją.',
        href: 'https://auth.quantjourney.cloud',
        mark: 'ID',
        tone: 'violet',
        access: 'Logowanie',
      },
      {
        name: 'Grafana',
        domain: 'grafana.quantjourney.cloud',
        description: 'Monitoring infrastruktury, dashboardy, alerty i analiza metryk.',
        href: 'https://grafana.quantjourney.cloud',
        mark: 'GF',
        tone: 'orange',
        access: 'Staff / VPN',
      },
      {
        name: 'Kafka Console',
        domain: 'kafka.quantjourney.cloud',
        description: 'Konsola strumieni zdarzeń i inspekcja ruchu Redpanda/Kafka.',
        href: 'https://kafka.quantjourney.cloud',
        mark: 'KF',
        tone: 'pink',
        access: 'Staff / VPN',
      },
    ],
  },
];
---

<SimpleLayout
  title="Control room | Jakub Polec"
  description="Unlisted directory of QuantJourney products and operational tools."
  noindex={true}
>
  <main class="links-page">
    <div class="page-glow glow-one" aria-hidden="true"></div>
    <div class="page-glow glow-two" aria-hidden="true"></div>

    <div class="links-shell">
      <header class="links-hero">
        <div class="hero-copy">
          <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span> PRIVATE DIRECTORY</p>
          <h1>Control room<span aria-hidden="true">.</span></h1>
          <p class="hero-lead">
            Jedno miejsce dla produktów QuantJourney i paneli, z których korzystasz na co dzień.
          </p>
        </div>
        <aside class="directory-note" aria-label="Directory note">
          <span class="note-icon" aria-hidden="true">↗</span>
          <p>Link nie jest podpięty w nawigacji ani indeksowany przez wyszukiwarki.</p>
          <small>Wrażliwe narzędzia zachowują własne logowanie oraz ograniczenia dostępu.</small>
        </aside>
      </header>

      {linkGroups.map((group) => (
        <section class="link-group" aria-labelledby={`group-${group.eyebrow.toLowerCase()}`}>
          <div class="group-heading">
            <p class="group-eyebrow">{group.eyebrow}</p>
            <div>
              <h2 id={`group-${group.eyebrow.toLowerCase()}`}>{group.title}</h2>
              <p>{group.description}</p>
            </div>
          </div>

          <div class="link-grid">
            {group.links.map((link) => (
              <a
                class="link-card"
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${link.name} — otwórz w nowej karcie`}
              >
                <div class:list={['card-mark', `mark-${link.tone}`]} aria-hidden="true">{link.mark}</div>
                <div class="card-copy">
                  <div class="card-title-row">
                    <h3>{link.name}</h3>
                    <span class="card-arrow" aria-hidden="true">↗</span>
                  </div>
                  <p>{link.description}</p>
                </div>
                <div class="card-footer">
                  <span class="card-domain">{link.domain}</span>
                  <span class="access-tag">{link.access}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}

      <footer class="links-footer">
        <span>Jakub Polec</span>
        <a href="/">← Wróć do strony głównej</a>
      </footer>
    </div>
  </main>
</SimpleLayout>

<style>
  .links-page {
    --canvas: #09111f;
    --panel: rgba(16, 28, 48, 0.74);
    --panel-hover: rgba(23, 40, 67, 0.94);
    --ink: #f5f8ff;
    --muted: #9eacc2;
    --line: rgba(169, 190, 222, 0.14);
    --line-strong: rgba(169, 190, 222, 0.24);
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    color: var(--ink);
    background:
      radial-gradient(circle at 12% -8%, rgba(42, 108, 245, 0.2), transparent 34rem),
      radial-gradient(circle at 92% 10%, rgba(115, 61, 215, 0.16), transparent 31rem),
      var(--canvas);
  }

  .page-glow {
    position: absolute;
    width: 32rem;
    height: 32rem;
    border-radius: 50%;
    filter: blur(110px);
    opacity: 0.17;
    pointer-events: none;
  }

  .glow-one {
    top: 34rem;
    left: -20rem;
    background: #075fe8;
  }

  .glow-two {
    right: -20rem;
    bottom: 1rem;
    background: #a236da;
  }

  .links-shell {
    position: relative;
    z-index: 1;
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    padding: 76px 0 42px;
  }

  .links-hero {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
    padding-bottom: 50px;
    border-bottom: 1px solid var(--line);
  }

  .hero-copy {
    max-width: 650px;
  }

  .eyebrow,
  .group-eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
    color: #aebde4;
    font-size: 0.69rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #75f2b4;
    box-shadow: 0 0 0 4px rgba(117, 242, 180, 0.11);
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 17px;
    color: var(--ink);
    font-size: clamp(3rem, 7vw, 5.8rem);
    font-weight: 800;
    letter-spacing: -0.08em;
    line-height: 0.92;
  }

  h1 span {
    color: #88a8ff;
  }

  .hero-lead {
    max-width: 580px;
    margin-bottom: 0;
    color: #c3cede;
    font-size: clamp(1rem, 1.8vw, 1.18rem);
    line-height: 1.65;
  }

  .directory-note {
    width: min(100%, 315px);
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: rgba(15, 27, 47, 0.58);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.14);
  }

  .note-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 27px;
    height: 27px;
    margin-bottom: 13px;
    border-radius: 8px;
    color: #cbd8ff;
    background: rgba(104, 138, 255, 0.16);
    font-size: 1rem;
  }

  .directory-note p {
    margin-bottom: 8px;
    color: #e4ebfb;
    font-size: 0.82rem;
    font-weight: 650;
    line-height: 1.45;
  }

  .directory-note small {
    display: block;
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.45;
  }

  .link-group {
    padding-top: 54px;
  }

  .group-heading {
    display: grid;
    grid-template-columns: 135px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
    margin-bottom: 24px;
  }

  .group-eyebrow {
    padding-top: 8px;
    margin: 0;
    color: #7183a2;
  }

  h2 {
    margin-bottom: 7px;
    color: var(--ink);
    font-size: clamp(1.55rem, 3vw, 2.08rem);
    letter-spacing: -0.045em;
    line-height: 1.1;
  }

  .group-heading div p {
    max-width: 700px;
    margin-bottom: 0;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .link-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 13px;
  }

  .link-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: 1fr auto;
    column-gap: 15px;
    min-height: 194px;
    padding: 19px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 17px;
    color: inherit;
    text-decoration: none;
    background: var(--panel);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.08);
    transition: transform 190ms ease, border-color 190ms ease, background 190ms ease, box-shadow 190ms ease;
  }

  .link-card:hover {
    transform: translateY(-4px);
    border-color: var(--line-strong);
    background: var(--panel-hover);
    box-shadow: 0 22px 42px rgba(0, 0, 0, 0.18);
  }

  .link-card:focus-visible {
    outline: 2px solid #9ab4ff;
    outline-offset: 3px;
  }

  .card-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 12px;
    font-size: 0.63rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .mark-blue { color: #bcd0ff; background: rgba(55, 112, 255, 0.17); }
  .mark-violet { color: #d8c2ff; background: rgba(137, 75, 255, 0.18); }
  .mark-teal { color: #a9f0e5; background: rgba(21, 176, 151, 0.16); }
  .mark-orange { color: #ffd5a5; background: rgba(234, 136, 51, 0.16); }
  .mark-pink { color: #ffc0e1; background: rgba(232, 67, 151, 0.16); }
  .mark-gold { color: #ffe49b; background: rgba(237, 178, 42, 0.16); }
  .mark-red { color: #ffb9b9; background: rgba(227, 74, 74, 0.16); }
  .mark-slate { color: #c8d2e1; background: rgba(143, 161, 185, 0.14); }

  .card-copy {
    min-width: 0;
  }

  .card-title-row {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 8px;
  }

  h3 {
    margin: 1px 0 8px;
    color: var(--ink);
    font-size: 1rem;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  .card-arrow {
    flex: 0 0 auto;
    color: #8396ba;
    font-size: 1.05rem;
    line-height: 1;
    transition: color 190ms ease, transform 190ms ease;
  }

  .link-card:hover .card-arrow {
    color: #d5e0ff;
    transform: translate(2px, -2px);
  }

  .card-copy p {
    margin: 0;
    color: var(--muted);
    font-size: 0.79rem;
    line-height: 1.52;
  }

  .card-footer {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding-top: 13px;
    border-top: 1px solid rgba(169, 190, 222, 0.1);
  }

  .card-domain {
    min-width: 0;
    overflow: hidden;
    color: #91a1ba;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.64rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .access-tag {
    flex: 0 0 auto;
    padding: 4px 7px;
    border: 1px solid rgba(168, 190, 221, 0.13);
    border-radius: 999px;
    color: #bfcbe0;
    background: rgba(170, 192, 226, 0.06);
    font-size: 0.61rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  .links-footer {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 70px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    color: #7183a2;
    font-size: 0.78rem;
  }

  .links-footer a {
    color: #b9c9ed;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .links-footer a:hover {
    color: #ffffff;
  }

  @media (max-width: 900px) {
    .link-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .links-hero {
      align-items: start;
      flex-direction: column;
    }

    .directory-note {
      width: min(100%, 500px);
    }
  }

  @media (max-width: 620px) {
    .links-shell {
      width: min(100% - 30px, 1180px);
      padding-top: 48px;
    }

    .links-hero {
      gap: 30px;
      padding-bottom: 37px;
    }

    .group-heading {
      grid-template-columns: 1fr;
      gap: 8px;
      margin-bottom: 18px;
    }

    .group-eyebrow {
      padding-top: 0;
    }

    .link-group {
      padding-top: 42px;
    }

    .link-grid {
      grid-template-columns: 1fr;
      gap: 11px;
    }

    .link-card {
      min-height: 168px;
    }

    .links-footer {
      align-items: start;
      flex-direction: column;
      margin-top: 50px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .link-card,
    .card-arrow {
      transition: none;
    }
  }
</style>
