---
import SimpleLayout from '../layouts/SimpleLayout.astro';
import { profile } from '../data/profile';

const canonical = profile.urls.ecosystem;
const personId = profile.personId;
const organizationId = profile.organisation.id;

const products = [
  {
    name: 'QuantJourney / OneBook',
    href: 'https://quantjourney.cloud',
    url: 'quantjourney.cloud',
    description: 'A buy-side investment operating layer connecting research, portfolio state, risk, decisions and execution.',
    points: [
      'Research, portfolio state, policy checks, approvals and outcomes in one decision record.',
      'Designed to work with an existing IBOR, PMS, OMS and risk stack.',
      'Private-deployment patterns for funds, family offices and investment teams.',
    ],
    linkLabel: 'Explore OneBook',
  },
  {
    name: 'Quant API',
    href: 'https://api.quantjourney.cloud/docs',
    url: 'api.quantjourney.cloud/docs',
    description: 'A managed financial-data API with governed routes, normalized contracts and approved MCP access.',
    points: [
      '540+ routes across 60+ data-source integrations and growing.',
      'REST, Python SDK and MCP share tenant-scoped controls.',
      'Provider selection, credentials, cache, fallback and audit context are operated centrally.',
    ],
    linkLabel: 'Read API documentation',
  },
  {
    name: 'Data Workspace',
    href: 'https://data.quantjourney.cloud',
    url: 'data.quantjourney.cloud',
    description: 'A financial warehouse and research workspace for fundamentals, portfolio data and analytical outputs.',
    points: [
      'Point-in-time statements, valuations, factor data and analytics from approved sources.',
      'Research, screening, portfolio and reporting workflows in one data platform.',
      'Approved Data MCP tools for controlled analytical workflows.',
    ],
    linkLabel: 'Open Data Workspace',
  },
  {
    name: 'Backtester',
    href: 'https://backtester.quantjourney.cloud',
    url: 'backtester.quantjourney.cloud',
    description: 'Python-native strategy research with reproducible workflows, diagnostics and reviewable outputs.',
    points: [
      'Signal, factor, allocation and order-aware research in one local Python workflow.',
      'Walk-forward validation, crisis diagnostics, execution-cost analysis and reports.',
      'A defined multi-engine benchmark is available separately.',
    ],
    linkLabel: 'See the benchmark',
    linkHref: 'https://backtester.quantjourney.cloud/compare',
  },
  {
    name: 'QuantJourney Agents',
    href: 'https://agents.quantjourney.cloud',
    url: 'agents.quantjourney.cloud',
    description: 'Governed agent access for financial and investment workflows through OAuth and MCP.',
    points: [
      'Approved tools, tenant-scoped capabilities and structured responses.',
      'Authentication, permissions and provider policy apply to every request.',
    ],
    linkLabel: 'Open agent gateway',
  },
];

const publicResearch = [
  {
    name: 'Quant Interviews',
    href: 'https://quant-interviews.quantjourney.cloud/',
    url: 'quant-interviews.quantjourney.cloud',
    description: 'A quantitative-research workbook: 194 questions, 14 chapters, 1,600+ pages, and Python/C++/SQL.',
    linkLabel: 'Explore Quant Interviews',
  },
  {
    name: 'Quant Blog',
    href: 'https://quantjourney.substack.com',
    url: 'quantjourney.substack.com',
    description: 'Long-form work on quantitative code, markets and investment infrastructure.',
    linkLabel: 'Read the Quant Blog',
  },
  {
    name: 'Open-source work',
    href: 'https://github.com/jpolec',
    url: 'github.com/jpolec',
    description: 'Public repositories, examples and release history.',
    linkLabel: 'Visit GitHub',
  },
];

const services = [
  {
    name: 'Strategy audit & validation',
    description: 'Independent review of data lineage, point-in-time assumptions, leakage and bias, portfolio construction, costs, execution assumptions and reproducibility.',
  },
  {
    name: 'Investment infrastructure',
    description: 'Architecture and delivery for data flows, IBOR/PMS/OMS integration, portfolio and risk workflows, controls and reporting.',
  },
  {
    name: 'Data + AI integration',
    description: 'Controlled data and AI integration for investment teams that need usable tools without giving up governance or operational context.',
  },
];

const technicalLinks = [
  {
    name: 'Agent gateway',
    href: 'https://agents.quantjourney.cloud',
    url: 'agents.quantjourney.cloud',
    description: 'Agent gateway',
  },
  {
    name: 'Agent card',
    href: 'https://agents.quantjourney.cloud/.well-known/agent-card.json',
    url: 'agents.quantjourney.cloud/.well-known/agent-card.json',
    description: 'Agent card',
  },
  {
    name: 'API MCP',
    href: 'https://api.quantjourney.cloud/mcp',
    url: 'api.quantjourney.cloud/mcp',
    description: 'API MCP',
  },
  {
    name: 'Data MCP',
    href: 'https://data.quantjourney.cloud/mcp',
    url: 'data.quantjourney.cloud/mcp',
    description: 'Data MCP',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: profile.name,
      url: profile.canonicalUrl,
      jobTitle: profile.jobTitle,
      description: profile.description,
      disambiguatingDescription: profile.disambiguatingDescription,
      worksFor: { '@id': organizationId },
      sameAs: profile.socialProfiles.map((socialProfile) => socialProfile.href),
      knowsAbout: [
        'Quantitative finance',
        'Systematic strategy research',
        'Investment technology',
        'Financial data infrastructure',
        'Portfolio management systems',
        'Investment operations',
        'Artificial intelligence',
      ],
    },
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: profile.organisation.name,
      url: profile.organisation.url,
      founder: { '@id': personId },
      description: 'QuantJourney builds governed research, data, portfolio, risk and AI infrastructure for investment workflows.',
    },
    {
      '@type': 'CollectionPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: 'QuantJourney ecosystem | Investment infrastructure, data and research',
      description: 'Core QuantJourney products, public research and selective investment-infrastructure work.',
      dateModified: '2026-09-03',
      inLanguage: 'en',
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: [...products, ...publicResearch].map((product, position) => ({
          '@type': 'ListItem',
          position: position + 1,
          url: product.href,
          name: product.name,
        })),
      },
      about: [{ '@id': personId }, { '@id': organizationId }],
    },
    ...products.slice(0, 5).map((product) => ({
      '@type': 'SoftwareApplication',
      name: product.name,
      url: product.href,
      description: product.description,
      applicationCategory: 'FinanceApplication',
      creator: { '@id': personId },
      publisher: { '@id': organizationId },
    })),
    ...services.map((service) => ({
      '@type': 'Service',
      name: service.name,
      description: service.description,
      serviceType: service.name,
      provider: { '@id': personId },
      audience: {
        '@type': 'Audience',
        audienceType: 'Hedge funds, asset managers, family offices, investment offices and quantitative research teams',
      },
      areaServed: 'Worldwide',
    })),
    {
      '@type': 'Book',
      name: 'Quant Interviews: Mathematics, Markets, Research and Systems',
      alternateName: 'Quant Interviews',
      url: 'https://quant-interviews.quantjourney.cloud/',
      author: { '@id': personId },
      publisher: { '@id': organizationId },
      numberOfPages: 1600,
      inLanguage: 'en',
      isAccessibleForFree: true,
      description: 'A senior quantitative-research review workbook with 194 questions, 14 chapters, executable labs and production-grade validation.',
    },
    {
      '@type': 'Blog',
      name: 'QuantJourney Blog',
      url: 'https://quantjourney.substack.com',
      author: { '@id': personId },
      publisher: { '@id': organizationId },
      description: 'Long-form quantitative code, markets and investment-infrastructure writing from QuantJourney.',
    },
  ],
};
---

<SimpleLayout
  title="QuantJourney ecosystem | Investment infrastructure, data & research"
  description="Core QuantJourney products, public research and selective investment-infrastructure work."
  canonical={canonical}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </Fragment>

  <main class="ecosystem-page">
    <div class="ecosystem-shell">
      <header class="page-header">
        <h1>Quant systems, financial data and buy-side infrastructure.</h1>
        <p class="lead">
          QuantJourney connects research, financial data, portfolio state, risk and AI into
          dependable investment workflows for funds, family offices and quant teams.
        </p>
        <div class="header-actions" aria-label="Consulting contact options">
          <a href="https://calendly.com/jpolec/30min" class="button primary" target="_blank" rel="noopener">Discuss an engagement</a>
          <a href="mailto:jakub@quantjourney.pro?subject=QuantJourney%20consulting%20enquiry" class="button primary">Email Jakub</a>
        </div>
      </header>

      <section class="consulting-section" aria-labelledby="consulting-title">
        <div class="section-heading">
          <p class="eyebrow">SELECTIVE CONSULTING</p>
          <h2 id="consulting-title">What I help with</h2>
          <p>
            I work selectively with funds, family offices and investment-technology companies on
            the operating systems behind investment decisions.
          </p>
        </div>
        <div class="service-list">
          {services.map((service) => (
            <article class="service-item">
              <h3>{service.name}</h3>
              <p>{service.description}</p>
            </article>
          ))}
        </div>
        <p class="service-note">
          This work covers technology, research process and operating controls. It does not provide
          investment advice, discretionary management, brokerage or custody.
        </p>
      </section>

      <section class="resource-section" aria-labelledby="products-title">
        <div class="section-heading">
          <h2 id="products-title">Core products</h2>
          <p>Products for research, portfolio workflows, data and controlled AI access.</p>
        </div>
        <div class="resource-list">
          {products.map((product) => (
            <article class="resource-item">
              <div class="resource-name">
                <h3><a href={product.href} target="_blank" rel="noopener noreferrer">{product.name}</a></h3>
                <a class="destination" href={product.href} target="_blank" rel="noopener noreferrer">{product.url}</a>
              </div>
              <div class="resource-copy">
                <p class="resource-summary">{product.description}</p>
                <ul>
                  {product.points.map((point) => <li>{point}</li>)}
                </ul>
              </div>
              <div class="resource-action">
                <a href={product.linkHref ?? product.href} target="_blank" rel="noopener noreferrer">
                  {product.linkLabel} <span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="resource-section public-research-section" aria-labelledby="research-title">
        <div class="section-heading">
          <h2 id="research-title">Public research</h2>
          <p>Selected work for quant practitioners, researchers and developers.</p>
        </div>
        <div class="resource-list public-research-list">
          {publicResearch.map((resource) => (
            <article class="resource-item">
              <div class="resource-name">
                <h3><a href={resource.href} target="_blank" rel="noopener noreferrer">{resource.name}</a></h3>
              </div>
              <div class="resource-copy"><p class="resource-summary">{resource.description}</p></div>
              <div class="resource-action">
                <a href={resource.href} target="_blank" rel="noopener noreferrer">
                  {resource.linkLabel} <span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <aside class="technical-entry-points" aria-labelledby="technical-title">
        <h2 id="technical-title">Developer &amp; agent entry points</h2>
        <p>
          Public technical destinations. Authentication, feature scopes and data entitlements apply.
        </p>
        <nav class="technical-links" aria-label="Developer and agent entry points">
          {technicalLinks.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.description} <span aria-hidden="true">↗</span>
            </a>
          ))}
        </nav>
        <p class="technical-note">
          Machine-readable discovery is available in <a href="/llms.txt">llms.txt</a> and
          <a href="/llms-full.txt">llms-full.txt</a>.
        </p>
      </aside>

      <footer>
        <a href="/">{profile.name}</a>
      </footer>
    </div>
  </main>
</SimpleLayout>

<style>
  .ecosystem-page {
    min-height: 100vh;
    background: var(--page-bg);
    color: var(--ink);
  }

  .ecosystem-shell {
    width: min(1020px, calc(100% - 40px));
    margin: 0 auto;
    padding: 88px 0 68px;
  }

  .page-header {
    max-width: 880px;
    padding-bottom: 54px;
    border-bottom: 1px solid var(--line);
  }

  .eyebrow {
    margin: 0 0 15px;
    color: var(--accent);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.13em;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 840px;
    margin-bottom: 14px;
    color: var(--ink);
    font-size: clamp(2.35rem, 5vw, 4.4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 0.98;
  }

  .lead {
    max-width: 680px;
    margin: 0;
    color: var(--muted);
    font-size: clamp(0.98rem, 1.45vw, 1.12rem);
    line-height: 1.58;
  }

  .lead a,
  .resource-item h3 a,
  footer a,
  .agent-note a,
  .profile-links a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .lead a:hover,
  .resource-item h3 a:hover,
  footer a:hover,
  .agent-note a:hover,
  .profile-links a:hover {
    color: var(--ink);
    text-decoration-color: var(--ink);
  }

  .technical-entry-points {
    max-width: 860px;
    margin-top: 72px;
    padding: 25px 28px;
    border: 1px solid var(--line);
    background: var(--surface-strong);
  }

  .technical-entry-points h2 {
    margin-bottom: 8px;
    font-size: 1rem;
  }

  .technical-entry-points > p,
  .technical-note {
    margin: 0;
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .technical-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin: 16px 0 12px;
  }

  .technical-links a,
  .technical-note a {
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }

  .technical-links a:hover,
  .technical-note a:hover {
    text-decoration-color: var(--ink);
  }

  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 19px;
  }

  .profile-links a {
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 650;
  }

  .header-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .header-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 11px 15px;
    border: 1px solid var(--ink);
    border-radius: 8px;
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.1;
    text-decoration: none;
    transition: background 160ms ease, color 160ms ease, border-color 160ms ease,
      transform 150ms ease, box-shadow 160ms ease;
  }

  .header-actions a:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--page-bg);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.16);
  }

  .header-actions a:active {
    transform: translateY(0);
  }

  .principles {
    margin-top: 54px;
    padding: 28px 30px;
    border-left: 3px solid var(--accent);
    background: var(--soft);
  }

  h2 {
    margin-bottom: 10px;
    color: var(--ink);
    font-size: clamp(1.55rem, 2.6vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }

  .principles h2 {
    margin-bottom: 16px;
    font-size: 1.16rem;
  }

  .principles ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .principles li {
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.58;
  }

  .principles strong {
    color: var(--ink);
  }

  .discovery-section,
  .consulting-section,
  .resource-section,
  .faq-section {
    margin-top: 76px;
  }

  .discovery-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 1px;
    background: var(--line);
    list-style: none;
  }

  .discovery-list li {
    padding: 19px 20px;
    background: var(--page-bg);
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.58;
  }

  .discovery-list li:last-child {
    grid-column: 1 / -1;
  }

  .section-heading {
    max-width: 790px;
    margin-bottom: 28px;
  }

  .section-heading p {
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .section-heading .eyebrow {
    margin-bottom: 12px;
  }

  .service-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .service-item {
    min-height: 188px;
    padding: 25px 24px 26px;
    border-right: 1px solid var(--line);
  }

  .service-item:first-child {
    padding-left: 0;
  }

  .service-item:last-child {
    padding-right: 0;
    border-right: 0;
  }

  h3 {
    margin: 0;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .service-item p,
  .service-note,
  .agent-note {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.62;
  }

  .service-note {
    max-width: 800px;
    margin-top: 16px;
    font-size: 0.8rem;
  }

  .resource-list {
    border-top: 1px solid var(--line);
  }

  .resource-item {
    display: grid;
    grid-template-columns: minmax(190px, 0.68fr) minmax(0, 1.85fr) minmax(135px, 0.48fr);
    gap: 28px;
    align-items: start;
    padding: 29px 0 30px;
    border-bottom: 1px solid var(--line);
  }

  .resource-name {
    display: grid;
    gap: 10px;
  }

  .resource-copy p {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 0.89rem;
    line-height: 1.63;
  }

  .resource-copy .resource-summary {
    color: var(--ink);
    font-size: 0.96rem;
    font-weight: 600;
    line-height: 1.58;
  }

  .resource-copy .resource-comparison {
    color: var(--ink);
    font-size: 0.86rem;
  }

  .resource-copy ul {
    margin: 15px 0 0;
    padding-left: 18px;
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.58;
  }

  .resource-copy li + li {
    margin-top: 6px;
  }

  .destination {
    color: var(--ink);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.72rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .destination:hover {
    text-decoration-color: var(--ink);
  }

  .resource-action {
    padding-top: 1px;
  }

  .resource-action > a:not(.destination) {
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 750;
    line-height: 1.45;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: border-color 160ms ease;
  }

  .resource-action > a:not(.destination):hover {
    border-color: var(--ink);
  }

  .agent-section {
    margin-top: 84px;
  }

  .agent-list .resource-item {
    padding: 22px 0;
  }

  .agent-list .resource-copy p {
    margin: 0;
  }

  .agent-note {
    max-width: 780px;
  }

  .faq-list {
    border-top: 1px solid var(--line);
  }

  .faq-list details {
    border-bottom: 1px solid var(--line);
  }

  .faq-list summary {
    position: relative;
    padding: 20px 32px 20px 0;
    color: var(--ink);
    cursor: pointer;
    font-size: 0.96rem;
    font-weight: 700;
    line-height: 1.45;
    list-style: none;
  }

  .faq-list summary::-webkit-details-marker {
    display: none;
  }

  .faq-list summary::after {
    position: absolute;
    top: 19px;
    right: 4px;
    color: var(--accent);
    content: '+';
    font-size: 1.2rem;
    font-weight: 400;
  }

  .faq-list details[open] summary::after {
    content: '−';
  }

  .faq-list p {
    max-width: 850px;
    margin: -2px 0 21px;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .attribution {
    max-width: 790px;
    margin-top: 82px;
    padding-top: 30px;
    border-top: 1px solid var(--line);
  }

  .attribution p {
    margin: 0;
    color: var(--muted);
    font-size: 0.99rem;
    line-height: 1.7;
  }

  .attribution-links {
    margin-top: 19px;
  }

  footer {
    margin-top: 70px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  footer a {
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 600;
  }

  @media (max-width: 820px) {
    .service-list {
      grid-template-columns: 1fr;
    }

    .service-item,
    .service-item:first-child,
    .service-item:last-child {
      min-height: 0;
      padding: 22px 0;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .service-item:last-child {
      border-bottom: 0;
    }

    .resource-item {
      grid-template-columns: minmax(160px, 0.65fr) minmax(0, 1.6fr);
    }

    .resource-action {
      grid-column: 2;
    }

    .agent-list .resource-action {
      grid-column: 2;
    }
  }

  @media (max-width: 620px) {
    .principles ul {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .resource-item {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 23px 0;
    }

    .discovery-list {
      grid-template-columns: 1fr;
    }

    .discovery-list li:last-child {
      grid-column: auto;
    }

    .resource-action,
    .agent-list .resource-action {
