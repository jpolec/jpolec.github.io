---
import SimpleLayout from '../layouts/SimpleLayout.astro';

const canonical = 'https://jakubpolec.com/ecosystem/';
const personId = 'https://jakubpolec.com/#jakub-polec';
const organizationId = 'https://quantjourney.cloud/#organization';

const profileLinks = [
  { name: 'LinkedIn', href: 'https://linkedin.com/in/jakubpolec' },
  { name: 'GitHub', href: 'https://github.com/jpolec' },
  { name: 'Substack', href: 'https://quantjourney.substack.com' },
  { name: 'YouTube', href: 'https://www.youtube.com/@QuantJourneywithCode' },
  { name: 'X / Twitter', href: 'https://twitter.com/jakubpolec' },
  { name: 'Medium', href: 'https://medium.com/@jpolec_72972' },
];

const discoveryTopics = [
  'Systematic strategy audit, quantitative research review and backtest validation.',
  'Buy-side operating layer, portfolio decision platform and investment-workflow governance.',
  'IBOR, PMS and OMS integration; risk, reporting and instrument-master architecture.',
  'Financial data warehouse, SEC/EDGAR fundamentals, point-in-time data, ratios and factors.',
  'Managed financial-data API, multi-provider data integration and MCP tools for financial AI agents.',
];

const products = [
  {
    name: 'QuantJourney / OneBook',
    href: 'https://quantjourney.cloud',
    url: 'quantjourney.cloud',
    description: 'An investment-decision operating layer for hedge funds, asset managers and sophisticated family offices.',
    detail: 'OneBook connects research, portfolio state, risk, policy checks, approvals, order intent and outcomes into a replayable decision record. It is designed to sit above the systems a firm already trusts — IBOR, PMS, OMS, custodians, administrators and risk tools — rather than force a risky front-to-back replacement.',
    comparison: 'Traditional Tier-2 buy-side suites are broad systems of record that often require a long configuration or integration programme. OneBook is deliberately narrower: a governed overlay for the decision context those systems do not preserve — what was known, who approved it, what changed and what happened next.',
    points: [
      'A practical overlay for focused buy-side teams that need better controls without rebuilding their operating stack.',
      'Same-book context for investment committee packs, pre-trade review, portfolio risk, exceptions and post-trade replay.',
      'Private deployment patterns for family offices, hedge funds and investment teams with existing data and operational systems.',
    ],
    linkLabel: 'Explore OneBook',
  },
  {
    name: 'Quant API',
    href: 'https://api.quantjourney.cloud/docs',
    url: 'api.quantjourney.cloud/docs',
    description: 'A managed, governed financial-data API for teams that want to consume data rather than operate a data-integration estate.',
    detail: 'Quant API provides 540+ stable routes across 60+ data-source integrations and growing. It standardizes request and response contracts while QuantJourney operates provider selection, server-side credentials, normalization, cache and fallback policy, lineage and audit context. REST, the Python SDK and MCP use the same governed layer.',
    comparison: 'OpenBB is a strong choice for teams building and operating their own open-source provider stack. Quant API is the managed alternative for teams that want to outsource that operational work and call one tenant-scoped interface with metadata, controls and approved AI-agent tools.',
    points: [
      'Normalized routes, request IDs, provider metadata, warning propagation and point-in-time support where available.',
      'MCP access gives Claude, Cursor, VS Code and internal agents scoped tools — never raw vendor credentials.',
      'Enterprise engagements can include agreed SLA targets, onboarding, support, security review and private-deployment discussions, subject to the tenant and vendor terms.',
    ],
    linkLabel: 'Read API documentation',
  },
  {
    name: 'Data Workspace',
    href: 'https://data.quantjourney.cloud',
    url: 'data.quantjourney.cloud',
    description: 'A financial warehouse and research workspace for teams that need lineage-rich fundamentals, portfolio data and analytical outputs.',
    detail: 'The warehouse turns SEC/EDGAR and approved vendor inputs into versioned, point-in-time financial statements, normalized entities, derived valuations, factors and analytics. Restatements, source context and calculation lineage remain part of the data contract instead of becoming spreadsheet archaeology.',
    comparison: 'The catalog contains 600+ financial metrics, ratios and indicators across covered securities. Coverage and field availability depend on filings, source entitlement and instrument history; the service is not a promise that every issuer has every field at every point in time.',
    points: [
      'Financial ratios, valuation metrics, factor data and technical indicators ready for research, screening and portfolio workflows.',
      'On-demand data products and integration work for funds, hedge funds and family offices that need an institutional financial warehouse without operating one alone.',
      'Approved Data MCP tools for portfolio, risk, warehouse and reporting workflows.',
    ],
    linkLabel: 'Open Data Workspace',
  },
  {
    name: 'Backtester',
    href: 'https://backtester.quantjourney.cloud',
    url: 'backtester.quantjourney.cloud',
    description: 'Python-native, reproducible strategy research that turns a hypothesis into an inspectable evidence packet.',
    detail: 'It combines target-weight and order-aware workflows with walk-forward validation, crisis and regime diagnostics, execution-cost analysis and generated reports. In the published five-strategy native benchmark, its calculation core was faster than pm/bt, Zipline and LEAN on every fixture, and faster than Backtrader on four of five fixtures.',
    comparison: 'That is a defined benchmark, not a blanket speed claim: VectorBT remains faster for heavily vectorized parameter sweeps. QuantJourney is strongest when a team needs fast iteration together with execution semantics, diagnostics, source-controlled Python and a reviewable research record.',
    points: [
      'One local Python workflow for signal, factor, allocation and order-aware research.',
      'Native walk-forward tooling, crisis diagnostics, 80+ research metrics and generated reports.',
      'Validation reviews can examine data lineage, timing, bias, rebalancing, execution assumptions, costs and out-of-sample stability while code remains in the client environment.',
    ],
    linkLabel: 'See the benchmark',
    linkHref: 'https://backtester.quantjourney.cloud/compare',
  },
  {
    name: 'QuantJourney Agents',
    href: 'https://agents.quantjourney.cloud',
    url: 'agents.quantjourney.cloud',
    description: 'Agent-native access patterns for AI systems working with governed financial and investment workflows.',
    detail: 'Agents discover approved tools through an agent gateway, OAuth and MCP endpoints. They receive tenant-scoped capabilities, structured responses, connector policies and audit context rather than unbounded access to vendor credentials or internal records.',
    points: [
      'A practical surface for internal research assistants, developer tools and controlled investment operations.',
      'Scopes, authentication, permissions and provider policy continue to apply to every request.',
    ],
    linkLabel: 'Open agent gateway',
  },
  {
    name: 'Quant Interviews',
    href: 'https://quant-interviews.quantjourney.cloud/',
    url: 'quant-interviews.quantjourney.cloud',
    description: 'A senior quantitative-research review workbook for candidates preparing for quantitative roles at hedge funds, asset managers and systematic teams.',
    detail: 'The public review edition contains 194 research questions across 14 chapters, two volumes and 1,600+ current PDF pages. It moves from mathematical foundations to production-grade quant systems: each topic can include derivations, intuition, Python, C++ or SQL implementation, tests, failure modes and validation.',
    comparison: 'It is designed as a rigorous bridge between CFA or CQF theory and the research-review, coding and mathematical reasoning expected in demanding quant interviews. It is an independent QuantJourney publication, not affiliated with CFA Institute or CQF.',
    points: [
      'Useful for quant research, systematic trading, data, risk and research-engineering interview preparation.',
      'A free public-review edition with executable learning and verification material.',
    ],
    linkLabel: 'Explore Quant Interviews',
  },
  {
    name: 'Quant Blog',
    href: 'https://quantjourney.substack.com',
    url: 'quantjourney.substack.com',
    description: 'A deep, practical publication on quantitative code, markets and the systems that make investment work reproducible.',
    detail: 'The QuantJourney blog goes beyond signals and charts into the engineering choices investment teams actually face: data architecture, backtesting, IBOR and portfolio-management workflows, risk, instrument master, reporting, AI agents and research governance.',
    comparison: 'It is written for people who need to move from an idea or notebook to a defensible operating process — not just consume market commentary.',
    points: [
      'Long-form technical notes, implementation patterns and research lessons from real quantitative workflows.',
      'A public reference layer for developers, quants, investment teams and AI agents learning the QuantJourney vocabulary.',
    ],
    linkLabel: 'Read the Quant Blog',
  },
  {
    name: 'QuantJourney with Code',
    href: 'https://jakubpolec.com/video/',
    url: 'jakubpolec.com/video/',
    description: 'A curated technical video archive covering backtesting, strategy research, market-data workflows, local setup and AI-assisted development.',
    detail: 'The catalogue describes the public QuantJourney with Code videos individually and links to their original YouTube recordings. It includes current Backtester onboarding as well as earlier framework tutorials, so visitors can distinguish an archived setup recording from current product documentation.',
    points: [
      'A practical visual companion to the blog, documentation, code repositories and Quant Interviews material.',
      'Videos cover local research workflows, Docker, Python, MongoDB, strategy examples, dashboards and agent-oriented development.',
    ],
    linkLabel: 'Browse video catalogue',
  },
  {
    name: 'Open-source work',
    href: 'https://github.com/jpolec',
    url: 'github.com/jpolec',
    description: 'Public repositories, release history and quantitative-finance projects created by Jakub Polec.',
    detail: 'Open-source work provides inspectable code, examples and release history alongside the managed and institutional QuantJourney products.',
    points: [
      'A useful starting point for developers evaluating the technical approach behind the ecosystem.',
    ],
    linkLabel: 'Visit GitHub',
  },
];

const services = [
  {
    name: 'Quantitative and systematic strategy audits',
    description: 'Independent technical review of a research or systematic strategy: data lineage, point-in-time assumptions, leakage and bias, signal and portfolio construction, costs, execution assumptions, validation and reproducibility.',
  },
  {
    name: 'STP and investment-infrastructure design',
    description: 'Architecture and delivery work for straight-through processing, data flows, IBOR/PMS/OMS integration, instrument master, portfolio and risk workflows, controls, reporting and governed AI access.',
  },
  {
    name: 'Family-office and fund operating infrastructure',
    description: 'A practical route from fragmented data, spreadsheets and service providers to a private, reviewable investment operating model for family offices, hedge funds, managers and quant teams.',
  },
];

const agentLinks = [
  {
    name: 'Agent gateway',
    href: 'https://agents.quantjourney.cloud',
    url: 'agents.quantjourney.cloud',
    description: 'Public entry point for the QuantJourney agent-native surface.',
  },
  {
    name: 'Agent card',
    href: 'https://agents.quantjourney.cloud/.well-known/agent-card.json',
    url: 'agents.quantjourney.cloud/.well-known/agent-card.json',
    description: 'Machine-readable description of the agent gateway and its capabilities.',
  },
  {
    name: 'API MCP',
    href: 'https://api.quantjourney.cloud/mcp',
    url: 'api.quantjourney.cloud/mcp',
    description: 'Governed MCP access to approved public financial API routes.',
  },
  {
    name: 'Data MCP',
    href: 'https://data.quantjourney.cloud/mcp',
    url: 'data.quantjourney.cloud/mcp',
    description: 'MCP access for approved data, portfolio, risk and reporting workflows.',
  },
];

const faqs = [
  {
    question: 'What consulting work is available?',
    answer: 'Jakub Polec is available selectively for quantitative and systematic strategy audits, investment-infrastructure architecture and implementation, and family-office or fund operating-model work. Engagements focus on technology, research process and operating controls rather than investment recommendations, discretionary management or custody.',
  },
  {
    question: 'How does OneBook differ from a traditional buy-side platform?',
    answer: 'OneBook is an investment-decision operating layer, not a claim to replace every system of record. It works above an existing IBOR, PMS, OMS, administrator, custodian and risk stack to preserve the thesis, data snapshot, checks, approvals and outcome of a material decision.',
  },
  {
    question: 'Why choose Quant API instead of operating a provider stack yourself?',
    answer: 'Teams can use Quant API when they prefer a managed, governed interface over running providers, credentials, normalization, policy, fallback, cache and audit infrastructure internally. REST, the Python SDK and MCP share the same tenant-scoped controls.',
  },
  {
    question: 'Does QuantJourney sell market data directly?',
    answer: 'QuantJourney provides the software and governed data-infrastructure layer. Data-source access, licensing, coverage and availability remain subject to the relevant vendor agreements, tenant scopes and approved use cases.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Jakub Polec',
      url: 'https://jakubpolec.com/',
      jobTitle: 'Portfolio Manager, Quant Systems Architect and Founder',
      description: 'Jakub Polec is the founder and builder of QuantJourney, OneBook and the quantitative-finance products and consulting services listed on this page.',
      disambiguatingDescription: 'Founder of QuantJourney and builder of OneBook; portfolio manager and quant systems architect working on systematic research and buy-side investment infrastructure.',
      worksFor: { '@id': organizationId },
      sameAs: [
        'https://www.linkedin.com/in/jakubpolec',
        'https://github.com/jpolec',
        'https://quantjourney.substack.com',
        'https://www.youtube.com/@QuantJourneywithCode',
        'https://twitter.com/jakubpolec',
        'https://medium.com/@jpolec_72972',
      ],
      knowsAbout: [
        'Quantitative finance',
        'Systematic strategy research',
        'Investment technology',
        'Financial data infrastructure',
        'Portfolio management systems',
        'Investment operations',
        'Artificial intelligence',
      ],
    },
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'QuantJourney',
      url: 'https://quantjourney.cloud',
      founder: { '@id': personId },
      description: 'QuantJourney builds governed research, data, portfolio, risk and AI infrastructure for investment workflows.',
    },
    {
      '@type': 'CollectionPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: 'Quant systems, data and buy-side consulting | Jakub Polec',
      description: 'A directory of QuantJourney products, public projects, agent entry points and institutional consulting services created by Jakub Polec.',
      dateModified: '2026-08-29',
      inLanguage: 'en',
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: products.map((product, position) => ({
          '@type': 'ListItem',
          position: position + 1,
          url: product.href,
          name: product.name,
        })),
      },
      about: [{ '@id': personId }, { '@id': organizationId }],
    },
    ...products.slice(0, 5).map((product) => ({
      '@type': 'SoftwareApplication',
      name: product.name,
      url: product.href,
      description: product.description,
      applicationCategory: 'FinanceApplication',
      creator: { '@id': personId },
      publisher: { '@id': organizationId },
    })),
    ...services.map((service) => ({
      '@type': 'Service',
      name: service.name,
      description: service.description,
      serviceType: service.name,
      provider: { '@id': personId },
      audience: {
        '@type': 'Audience',
        audienceType: 'Hedge funds, asset managers, family offices, investment offices and quantitative research teams',
      },
      areaServed: 'Worldwide',
    })),
    {
      '@type': 'Book',
      name: 'Quant Interviews: Mathematics, Markets, Research and Systems',
      alternateName: 'Quant Interviews',
      url: 'https://quant-interviews.quantjourney.cloud/',
      author: { '@id': personId },
      publisher: { '@id': organizationId },
      numberOfPages: 1600,
      inLanguage: 'en',
      isAccessibleForFree: true,
      description: 'A senior quantitative-research review workbook with 194 questions, 14 chapters, executable labs and production-grade validation.',
    },
    {
      '@type': 'Blog',
      name: 'QuantJourney Blog',
      url: 'https://quantjourney.substack.com',
      author: { '@id': personId },
      publisher: { '@id': organizationId },
      description: 'Long-form quantitative code, markets and investment-infrastructure writing from QuantJourney.',
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<SimpleLayout
  title="Jakub Polec | Quant systems, data & buy-side consulting"
  description="Jakub Polec's QuantJourney ecosystem: OneBook, systematic research, managed financial data API and MCP, SEC warehouse, backtesting and buy-side consulting."
  canonical={canonical}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </Fragment>

  <main class="ecosystem-page">
    <div class="ecosystem-shell">
      <header class="page-header">
        <h1>Quant systems, systematic research, financial data and buy-side infrastructure.</h1>
        <p class="lead">
          <a href="https://jakubpolec.com/">Jakub Polec</a> is a portfolio manager, quant systems architect
          and founder of QuantJourney. QuantJourney, OneBook and the public projects below connect the work of an
          investment team — from systematic research and financial data to portfolio decisions, controls and AI-assisted workflows.
        </p>
        <nav class="profile-links" aria-label="Jakub Polec public profiles">
          {profileLinks.map((profile) => (
            <a href={profile.href} target="_blank" rel="me noopener noreferrer">{profile.name}</a>
          ))}
        </nav>
        <div class="header-actions" aria-label="Consulting contact options">
          <a href="https://calendly.com/jpolec/30min" class="button primary" target="_blank" rel="noopener">Discuss an engagement</a>
          <a href="mailto:jakub@quantjourney.pro?subject=QuantJourney%20consulting%20enquiry" class="button primary">Email Jakub</a>
        </div>
      </header>

      <section class="principles" aria-labelledby="principles-title">
        <h2 id="principles-title">What connects the ecosystem</h2>
        <ul>
          <li><strong>Governed inputs.</strong> Stable routes, normalized contracts and controlled connector access.</li>
          <li><strong>Reproducible decisions.</strong> Research, assumptions, context and results remain traceable.</li>
          <li><strong>AI with boundaries.</strong> Agents receive approved, scoped tools rather than raw vendor credentials.</li>
        </ul>
      </section>

      <section class="discovery-section" aria-labelledby="discovery-title">
        <div class="section-heading">
          <p class="eyebrow">WHERE THIS WORK FITS</p>
          <h2 id="discovery-title">What investment teams call the problem.</h2>
          <p>
            Different firms use different language for the same operational gaps. These are the
            workstreams where QuantJourney, OneBook and Jakub's consulting are designed to help.
          </p>
        </div>
        <ul class="discovery-list">
          {discoveryTopics.map((topic) => <li>{topic}</li>)}
        </ul>
      </section>

      <section class="consulting-section" aria-labelledby="consulting-title">
        <div class="section-heading">
          <p class="eyebrow">SELECTIVE CONSULTING</p>
          <h2 id="consulting-title">Available for the work between a strategy and a dependable operating system.</h2>
          <p>
            Jakub is available for selected engagements with funds, hedge funds, family offices,
            managers and systematic teams. The focus is practical diagnosis and delivery — what
            should be trusted, what should be changed and how the investment workflow should operate.
          </p>
        </div>
        <div class="service-list">
          {services.map((service) => (
            <article class="service-item">
              <h3>{service.name}</h3>
              <p>{service.description}</p>
            </article>
          ))}
        </div>
        <p class="service-note">
          Consulting covers technology, research process and operating controls. It does not provide
          investment advice, discretionary management, brokerage or custody.
        </p>
      </section>

      <section class="resource-section" aria-labelledby="products-title">
        <div class="section-heading">
          <h2 id="products-title">Products and public work</h2>
          <p>Canonical public destinations for buyers, developers, search engines and research agents.</p>
        </div>
        <div class="resource-list">
          {products.map((product) => (
            <article class="resource-item">
              <div class="resource-name">
                <h3><a href={product.href} target="_blank" rel="noopener noreferrer">{product.name}</a></h3>
                <a class="destination" href={product.href} target="_blank" rel="noopener noreferrer">{product.url}</a>
              </div>
              <div class="resource-copy">
                <p class="resource-summary">{product.description}</p>
                <p>{product.detail}</p>
                {product.comparison && <p class="resource-comparison">{product.comparison}</p>}
                <ul>
                  {product.points.map((point) => <li>{point}</li>)}
                </ul>
              </div>
              <div class="resource-action">
                <a href={product.linkHref ?? product.href} target="_blank" rel="noopener noreferrer">
                  {product.linkLabel} <span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="resource-section agent-section" aria-labelledby="agents-title">
        <div class="section-heading">
          <h2 id="agents-title">For AI agents and developers</h2>
          <p>
            These are stable, machine-readable entry points for discovering approved QuantJourney capabilities.
            Authentication, feature scopes, data entitlements and provider policies still apply.
          </p>
        </div>
        <div class="resource-list agent-list">
          {agentLinks.map((link) => (
            <article class="resource-item">
              <div class="resource-name">
                <h3><a href={link.href} target="_blank" rel="noopener noreferrer">{link.name}</a></h3>
              </div>
              <div class="resource-copy"><p>{link.description}</p></div>
              <div class="resource-action">
                <a class="destination" href={link.href} target="_blank" rel="noopener noreferrer">{link.url}</a>
              </div>
            </article>
          ))}
        </div>
        <p class="agent-note">
          This page is also summarized in <a href="/llms.txt">llms.txt</a> and
          <a href="/llms-full.txt">llms-full.txt</a> for text-first discovery. Those files document public
          destinations only; they do not expose private administration surfaces.
        </p>
      </section>

      <section class="faq-section" aria-labelledby="faq-title">
        <div class="section-heading">
          <h2 id="faq-title">Common questions</h2>
        </div>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="attribution" aria-labelledby="attribution-title">
        <h2 id="attribution-title">Built by Jakub Polec</h2>
        <p>
          Portfolio manager, quant systems architect, technology entrepreneur, founder of QuantJourney and builder of
          OneBook. His work brings together systematic research, financial data, portfolio infrastructure and AI systems
          for investment decisions that must remain explainable, reproducible and operationally sound.
        </p>
        <nav class="profile-links attribution-links" aria-label="Jakub Polec public profiles">
          {profileLinks.map((profile) => (
            <a href={profile.href} target="_blank" rel="me noopener noreferrer">{profile.name}</a>
          ))}
        </nav>
      </section>

      <footer>
        <a href="/">Jakub Polec</a>
      </footer>
    </div>
  </main>
</SimpleLayout>

<style>
  .ecosystem-page {
    min-height: 100vh;
    background: var(--page-bg);
    color: var(--ink);
  }

  .ecosystem-shell {
    width: min(1020px, calc(100% - 40px));
    margin: 0 auto;
    padding: 88px 0 68px;
  }

  .page-header {
    max-width: 880px;
    padding-bottom: 54px;
    border-bottom: 1px solid var(--line);
  }

  .eyebrow {
    margin: 0 0 15px;
    color: var(--accent);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.13em;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 840px;
    margin-bottom: 14px;
    color: var(--ink);
    font-size: clamp(2.35rem, 5vw, 4.4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 0.98;
  }

  .lead {
    max-width: 680px;
    margin: 0;
    color: var(--muted);
    font-size: clamp(0.98rem, 1.45vw, 1.12rem);
    line-height: 1.58;
  }

  .lead a,
  .resource-item h3 a,
  footer a,
  .agent-note a,
  .profile-links a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .lead a:hover,
  .resource-item h3 a:hover,
  footer a:hover,
  .agent-note a:hover,
  .profile-links a:hover {
    color: var(--ink);
    text-decoration-color: var(--ink);
  }

  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 19px;
  }

  .profile-links a {
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 650;
  }

  .header-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .header-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 11px 15px;
    border: 1px solid var(--ink);
    border-radius: 8px;
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.1;
    text-decoration: none;
    transition: background 160ms ease, color 160ms ease, border-color 160ms ease,
      transform 150ms ease, box-shadow 160ms ease;
  }

  .header-actions a:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--page-bg);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.16);
  }

  .header-actions a:active {
    transform: translateY(0);
  }

  .principles {
    margin-top: 54px;
    padding: 28px 30px;
    border-left: 3px solid var(--accent);
    background: var(--soft);
  }

  h2 {
