---
import SimpleLayout from '../layouts/SimpleLayout.astro';

const panels = [
  { title: 'Hire Admin', description: 'Applications, CVs, notes and recruitment status.', href: 'https://quantjourney.cloud/hire-admin/' },
  { title: 'Book Admin', description: 'Quant Interviews readers and book administration.', href: 'https://quant-interviews.quantjourney.cloud/book-admin' },
  { title: 'Agents Admin', description: 'QuantJourney Agents administration.', href: 'https://agents.quantjourney.cloud/agents/admin' },
];
---

<SimpleLayout title="Admin links | Jakub Połeć" description="Links to separately protected administration panels." noindex>
  <main class="private-shell">
    <a class="back" href="/">← jakubpolec.com</a>
    <p class="eyebrow">Personal shortcuts</p>
    <h1>Admin links</h1>
    <p class="intro">Each panel requires its own login. This page contains links only — no passwords or access tokens.</p>
    <nav aria-label="Administration panels">
      {panels.map((panel) => (
        <a class="panel" href={panel.href} target="_blank" rel="noopener noreferrer">
          <span><strong>{panel.title}</strong><small>{panel.description}</small></span>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </nav>
  </main>
</SimpleLayout>

<style>
  :global(html:root) { background: #0d624a; }
  :global(html body) { background: #f4f0e8; min-height: 100vh; }
  .private-shell { width: min(850px, calc(100% - 40px)); margin: auto; padding: 64px 0 100px; }
  .back { font-size: .9rem; text-decoration: none; }
  .eyebrow { margin-top: 80px; font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; }
  h1 { font-size: clamp(2.7rem, 7vw, 4.5rem); line-height: 1; letter-spacing: -.04em; margin: 20px 0; }
  .intro { max-width: 600px; line-height: 1.7; margin-bottom: 40px; }
  nav { border-top: 1px solid #bec5c6; }
  .panel { display: flex; align-items: center; justify-content: space-between; gap: 24px; border-bottom: 1px solid #bec5c6; padding: 28px 8px; text-decoration: none; }
  .panel:hover { background: #fff8; }
  strong { display: block; font-size: 1.4rem; margin-bottom: 8px; }
  small { display: block; font-size: .92rem; line-height: 1.5; }
</style>
