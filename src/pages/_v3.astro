---
import SimpleLayout from '../layouts/SimpleLayout.astro';
import { services } from '../data/v15-services';

const situations = [
  {
    title: 'Validate a system',
    text: 'Someone claims a system works, and the decision depends on whether that is true.',
  },
  {
    title: 'Check before allocating capital',
    text: 'A strategy is about to receive capital, and nobody in the room has independently checked the research behind it.',
  },
  {
    title: 'Untangle the infrastructure',
    text: 'Research, data, portfolio, risk, and execution have grown into something nobody can trace end to end, and a decision has to be made about what to build, buy, or replace.',
  },
];

const products = [
  {
    name: 'OneBook',
    destination: 'onebook.quantjourney.cloud',
    description: 'A buy-side investment operating layer connecting research, portfolio state, risk, decisions, and execution.',
    href: 'https://onebook.quantjourney.cloud/',
  },
  {
    name: 'Quant API / MCP',
    destination: 'api.quantjourney.cloud',
    description: 'Managed financial-data infrastructure with governed routes, normalized contracts, and approved MCP access.',
    href: 'https://api.quantjourney.cloud/',
  },
  {
    name: 'Backtester',
    destination: 'backtester.quantjourney.cloud',
    description: 'Python-native strategy research with reproducible workflows, diagnostics, and reviewable outputs.',
    href: 'https://backtester.quantjourney.cloud/',
  },
  {
    name: 'Quant Infra',
    destination: 'quantjourney.cloud',
    description: 'Proprietary infrastructure design and delivery for hedge funds, other investment funds, family offices, and investment teams.',
    href: 'https://quantjourney.cloud/',
  },
  {
    name: 'Agents',
    destination: 'agents.quantjourney.cloud',
    description: 'Controlled tools for approved financial and investment workflows, with OAuth, scoped access, and MCP.',
    href: 'https://agents.quantjourney.cloud/',
  },
];

const selectedPosts = [
  {
    title: 'Designing a Real Portfolio Management System',
    description: 'PMS design: keeping positions and cash consistent, with portfolio state that can be rebuilt day by day.',
    href: 'https://quantjourney.substack.com/p/designing-a-real-portfolio-management',
  },
  {
    title: 'QuantJourney Backtester Is Now Open Source',
    description: 'Backtest reliability: tracing when information becomes tradable, how signals become positions, and which execution, cost and validation assumptions shape the results.',
    href: 'https://quantjourney.substack.com/p/quantjourney-backtester-is-now-open',
  },
  {
    title: 'Moving Beyond Correlation — Hunting Alpha with Lead-Lag & Granger Causality',
    description: 'Alpha research: distinguishing statistical lead-lag relationships from an economic edge, and examining how those relationships change across market regimes.',
    href: 'https://quantjourney.substack.com/p/moving-beyond-correlation-hunting',
  },
  {
    title: 'AI-Agent-Native Investment Infrastructure',
    description: 'Applied AI: connecting agents to controlled portfolio, market-data, risk, and research infrastructure through MCP.',
    href: 'https://quantjourney.substack.com/p/ai-agent-native-investment-infrastructure',
  },
];
---

<SimpleLayout
  title="Jakub Połeć — independent review of quantitative systems"
  description="Independent review of quantitative research, investment infrastructure, and technology for hedge funds, family offices, and investors in investment technology."
  canonical="https://jakubpolec.com/_v3/"
  noindex={true}
>
  <main class="editorial-shell">
    <header class="profile-header">
      <h1>Jakub Połeć</h1>
      <p class="profile-discipline">Quantitative systems / investment infrastructure</p>
      <p class="hero-positioning">Independent review before you allocate capital, acquire technology, or put a quantitative system into production.</p>
      <p class="hero-method">I review and design quantitative systems, investment infrastructure, and the research behind them—and put the answer in writing.</p>
      <nav aria-label="Contact and profiles">
        <a href="https://calendly.com/jpolec/30min" target="_blank" rel="noopener">Book a call</a>
        <!--email_off--><a href="mailto:jakub@quantjourney.pro">Email</a><!--/email_off-->
        <a href="https://linkedin.com/in/jakubpolec" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://github.com/jpolec" target="_blank" rel="noopener">GitHub</a>
      </nav>
    </header>

    <section class="portrait-statement" aria-label="Introduction">
      <figure>
        <img src="/jakub-polec-seated.webp" alt="Portrait of Jakub Połeć" width="600" height="750" loading="eager" decoding="async" />
      </figure>
      <div class="statement">
        <blockquote>“The decision depends on whether the system actually works.”</blockquote>
        <a href="#work-with-me">How I help <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <section class="profile-columns" aria-label="Background and reasons to work together">
      <article>
        <p class="section-label">Background</p>
        <p>I work with hedge funds, family offices, asset managers, and investors in investment technology. My background spans high-energy physics at CERN, Microsoft, Oracle, and more than a decade building data-intensive, AI, and quantitative systems.</p>
        <p>I co-founded and led three technology startups, raised VC funding, and completed one exit. I now run QuantJourney, which builds investment infrastructure for buy-side teams.</p>
        <p class="small-note">Based in Dubai, UAE. I do not manage client capital and do not give investment advice.</p>
      </article>
      <article>
        <p class="section-label">When people call me</p>
        <div class="situation-list">
          {situations.map((situation) => (
            <div>
              <h2>{situation.title}</h2>
              <p>{situation.text}</p>
            </div>
          ))}
        </div>
        <a class="outline-button" href="https://calendly.com/jpolec/30min" target="_blank" rel="noopener">Get in touch with Jakub</a>
      </article>
    </section>

    <section class="proof-band" aria-label="Selected experience">
      <div><strong>3</strong><span>startups co-founded and led</span></div>
      <div><strong>VC</strong><span>funding raised</span></div>
      <div><strong>1</strong><span>exit</span></div>
      <div><strong>100+</strong><span>paying customers across our API and investment infrastructure products</span></div>
    </section>

    <section id="work-with-me" class="large-section services-section" aria-labelledby="services-title">
      <header class="centered-heading">
        <p class="section-label">Work with me</p>
        <h2 id="services-title">Independent review and architecture</h2>
        <p>I take a small number of engagements at a time. Each one is fixed-scope, written up, and delivered on a date agreed in advance.</p>
        <p>Over the past three years, my work has included engagements with 3 hedge funds, 2 family offices, and 2 insurers across the US, India, Japan, and the Middle East.</p>
      </header>
      <div class="service-table">
        <div class="table-head" aria-hidden="true">
          <span>Engagement</span><span>Scope and output</span><span>Timing / fee</span>
        </div>
        {services.map((service) => (
          <article class="service-row">
            <h3>{service.title}</h3>
            <div class="service-description">
              <p>{service.description}</p>
              <p><strong>You receive:</strong> {service.deliverable.replace('You receive ', '')}</p>
              <a href={`/services/${service.slug}/`}>Full scope <span aria-hidden="true">↗</span></a>
            </div>
            <div class="service-scope">
              <span>{service.duration}</span>
              <strong>{service.fee}</strong>
              {service.note && <small>{service.note}</small>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="large-section build-section" aria-labelledby="build-title">
      <header class="centered-heading compact-heading">
        <p class="section-label">What I build</p>
        <h2 id="build-title">QuantJourney systems</h2>
        <p>QuantJourney is my company. We build and operate investment systems used across research, portfolio management, risk, data, execution, and applied AI.</p>
      </header>
      <div class="product-table">
        <div class="product-head" aria-hidden="true"><span>System</span><span>What it does</span><span>Open</span></div>
        {products.map((product) => (
          <a class="product-row" href={product.href} target="_blank" rel="noopener">
            <span class="product-name"><strong>{product.name}</strong><small>{product.destination}</small></span>
            <span class="product-description">{product.description}</span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="large-section published-section" aria-labelledby="published-title">
      <header class="centered-heading compact-heading">
        <p class="section-label">Published work</p>
        <h2 id="published-title">Book and selected research</h2>
      </header>
      <div class="book-feature">
        <div class="book-image" aria-label="Quant Interviews volumes">
          <img src="/quant-interviews-volume-1.svg" alt="Quant Interviews Volume I cover" width="540" height="763" loading="lazy" decoding="async" />
          <img src="/quant-interviews-volume-2.svg" alt="Quant Interviews Volume II cover" width="540" height="763" loading="lazy" decoding="async" />
        </div>
        <div class="book-copy">
          <p class="section-label">Quant Interviews</p>
          <h3>From mathematical foundations to production-grade quant systems.</h3>
          <p>1,630 pages · 194 questions · Python / C++ / SQL</p>
          <a class="outline-button" href="https://quant-interviews.quantjourney.cloud" target="_blank" rel="noopener">Open the book</a>
        </div>
      </div>

      <div class="research-heading">
        <h3>Selected Research</h3>
        <p>On the QuantJourney blog, I have published 250+ articles covering investment strategies, alpha research, backtesting, portfolio construction, risk, data engineering, execution, and applied AI.</p>
      </div>
      <div class="research-grid">
        {selectedPosts.map((post) => (
          <a href={post.href} target="_blank" rel="noopener">
            <span class="section-label">Research</span>
            <h3>{post.title}</h3>
            <p>{post.description}</p>
            <span class="read-link">Read <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
      <p class="more-link"><a href="https://quantjourney.substack.com" target="_blank" rel="noopener">More on the QuantJourney blog <span aria-hidden="true">↗</span></a></p>
    </section>

    <section class="personal-section" aria-labelledby="personal-title">
      <p class="section-label">Personal side</p>
      <h2 id="personal-title">
        <span>Padel</span><i>/</i><span>Diving</span><i>/</i><span>Action movies</span><i>/</i><span>Puzzles</span><i>/</i><span>Foodie</span><i>/</i><span>Travel</span><i>/</i><button type="button" class="cocker-trigger">My cocker spaniel</button>
      </h2>
    </section>

    <section class="closing-section" aria-labelledby="closing-title">
      <p class="section-label">Get in touch</p>
      <h2 id="closing-title">Bring the decision you are facing and whatever material you have.</h2>
      <p>In thirty minutes, I will tell you whether I can help, what it would take, and what it would cost.</p>
      <div>
        <a class="outline-button light-button" href="https://calendly.com/jpolec/30min" target="_blank" rel="noopener">Book a 30-minute call</a>
        <!--email_off--><a class="text-contact" href="mailto:jakub@quantjourney.pro">jakub@quantjourney.pro</a><!--/email_off-->
      </div>
    </section>
  </main>

  <dialog class="cocker-dialog" aria-label="My cocker spaniel">
    <button type="button" class="cocker-close" aria-label="Close photo">×</button>
    <img src="/cocker-spaniel.webp" alt="Jakub's black cocker spaniel resting on a sofa" width="1200" height="1600" loading="lazy" decoding="async" />
  </dialog>

  <script>
    const dialog = document.querySelector<HTMLDialogElement>('.cocker-dialog');
    const trigger = document.querySelector<HTMLButtonElement>('.cocker-trigger');
    const close = document.querySelector<HTMLButtonElement>('.cocker-close');
    trigger?.addEventListener('click', () => dialog?.showModal());
    close?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  </script>
</SimpleLayout>

<style>
  :global(body) { background: #f4f0e8; }

  .editorial-shell {
    --paper: #f4f0e8;
    --ink: #052d57;
    --muted: #36516e;
    --line: #c9d2dc;
    --accent: #052d57;
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    padding: 28px 0 0;
    color: var(--ink);
  }

  .editorial-shell h1, .editorial-shell h2, .editorial-shell h3, .editorial-shell p, .editorial-shell figure, .editorial-shell blockquote { margin: 0; }
  .editorial-shell p { color: var(--muted); }
  .editorial-shell a { text-underline-offset: 4px; }
  .editorial-shell h1, .editorial-shell h2, .centered-heading h2, .personal-section h2 {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 400;
    text-transform: uppercase;
  }

  .section-label {
    color: var(--muted) !important;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: .78rem !important;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .profile-header { padding: 70px 0 32px; text-align: center; }
  .profile-header h1 { font-size: clamp(3.2rem, 8.5vw, 7.6rem); line-height: .96; letter-spacing: .08em; }
  .profile-discipline { margin-top: 14px; color: var(--ink) !important; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: clamp(.96rem, 1.7vw, 1.4rem); letter-spacing: .08em; text-transform: uppercase; }
  .hero-positioning { max-width: 980px; margin: 48px auto 0 !important; color: var(--ink) !important; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(1.5rem, 3.2vw, 2.55rem); line-height: 1.32; text-wrap: balance; }
  .hero-method { max-width: 820px; margin: 20px auto 0 !important; font-size: clamp(1rem, 1.35vw, 1.14rem); line-height: 1.65; text-wrap: balance; }
  .profile-header nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 22px; margin-top: 32px; }
  .profile-header nav a { color: var(--ink); font-size: .8rem; text-transform: uppercase; }

  .portrait-statement { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .portrait-statement figure { height: clamp(420px, 52vw, 630px); border-right: 1px solid var(--line); padding: 12px 12px 12px 0; }
  .portrait-statement img { width: 100%; height: 100%; object-fit: cover; object-position: center 33%; }
  .statement { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: clamp(30px, 7vw, 90px); text-align: center; }
  .statement blockquote { max-width: 440px; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(1.35rem, 2.5vw, 2.15rem); font-style: italic; line-height: 1.4; }
  .statement a { margin-top: 42px; color: var(--ink); font-size: .8rem; text-transform: uppercase; }

  .profile-columns { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid var(--line); }
  .profile-columns > article { padding: 24px clamp(20px, 3.5vw, 48px) 46px 12px; }
  .profile-columns > article + article { border-left: 1px solid var(--line); padding-right: 12px; padding-left: clamp(20px, 3.5vw, 48px); }
  .profile-columns article > p:not(.section-label) { margin-top: 22px; font-family: Georgia, 'Times New Roman', serif; font-size: 1.08rem; line-height: 1.68; }
  .profile-columns article > .small-note { font-family: inherit !important; font-size: .82rem !important; }
  .situation-list > div { margin-top: 22px; }
  .situation-list h2 { font-family: inherit; font-size: 1.06rem; font-weight: 600; line-height: 1.4; text-transform: none; }
  .situation-list p { margin-top: 7px; font-family: Georgia, 'Times New Roman', serif; font-size: 1.04rem; line-height: 1.6; }

  .outline-button { display: inline-flex; min-height: 44px; align-items: center; justify-content: center; margin-top: 28px; border: 1px solid var(--ink); border-radius: 999px; padding: 10px 23px; color: var(--ink); font-size: .8rem; text-decoration: none; }
  .outline-button:hover { background: var(--ink); color: var(--paper); }

  .proof-band { display: grid; grid-template-columns: repeat(4, 1fr); padding: 32px 0 34px; border-bottom: 1px solid var(--line); }
  .proof-band > div { padding: 0 24px; text-align: center; }
  .proof-band > div + div { border-left: 1px solid var(--line); }
  .proof-band strong { display: block; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 400; }
  .proof-band span { display: block; max-width: 235px; margin: 7px auto 0; color: var(--muted); font-size: .76rem; line-height: 1.4; text-transform: uppercase; }

  .large-section { padding: clamp(72px, 10vw, 130px) 0; border-bottom: 1px solid var(--line); }
  .centered-heading { max-width: 760px; margin: 0 auto 54px; text-align: center; }
  .centered-heading h2 { margin-top: 16px; font-size: clamp(1.9rem, 4vw, 3.3rem); line-height: 1.2; letter-spacing: .04em; }
  .centered-heading > p:not(.section-label) { margin-top: 19px; font-family: Georgia, 'Times New Roman', serif; font-size: 1.06rem; line-height: 1.65; }
  .compact-heading { margin-bottom: 46px; }

  .table-head, .service-row { display: grid; grid-template-columns: minmax(180px, .72fr) minmax(340px, 1.45fr) minmax(130px, .45fr); gap: clamp(25px, 4vw, 58px); }
  .table-head { padding: 10px 0; border-bottom: 1px solid var(--ink); font-size: .72rem; letter-spacing: .07em; text-transform: uppercase; }
  .service-row { padding: 29px 0; border-bottom: 1px solid var(--line); }
  .service-row h3 { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 1.02rem; font-weight: 400; line-height: 1.4; text-transform: uppercase; }
  .service-description p { font-family: Georgia, 'Times New Roman', serif; font-size: .98rem; line-height: 1.62; }
  .service-description p + p { margin-top: 13px; }
  .service-description strong { color: var(--ink); }
  .service-description a { display: inline-block; margin-top: 15px; color: var(--ink); font-size: .8rem; }
  .service-scope { display: flex; flex-direction: column; gap: 7px; font-size: .84rem; }
  .service-scope strong { font-weight: 600; }
  .service-scope small { margin-top: 5px; color: var(--muted); line-height: 1.45; }

  .product-head, .product-row { display: grid; grid-template-columns: minmax(180px, .75fr) minmax(360px, 1.6fr) 40px; gap: 32px; }
  .product-head { padding: 10px 0; border-bottom: 1px solid var(--ink); font-size: .72rem; letter-spacing: .07em; text-transform: uppercase; }
  .product-row { align-items: center; padding: 23px 0; border-bottom: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .product-name { display: flex; flex-direction: column; gap: 5px; }
  .product-name strong { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 1rem; font-weight: 400; text-transform: uppercase; }
  .product-name small { color: var(--muted); font-size: .7rem; }
  .product-description { color: var(--muted); font-family: Georgia, 'Times New Roman', serif; font-size: .96rem; line-height: 1.55; }
  .product-row:hover .product-name strong { text-decoration: underline; text-underline-offset: 4px; }

  .book-feature { display: grid; grid-template-columns: 1.05fr .95fr; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .book-image { display: flex; align-items: end; justify-content: center; gap: 18px; overflow: hidden; min-height: 470px; border-right: 1px solid var(--line); padding: 34px 34px 0; background: #e9e4d9; }
  .book-image img { width: min(43%, 210px); box-shadow: 0 12px 24px rgba(0, 0, 0, .11); }
  .book-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(36px, 6vw, 78px); }
  .book-copy h3 { margin-top: 30px; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(1.55rem, 3vw, 2.45rem); font-weight: 400; line-height: 1.25; }
  .book-copy > p:not(.section-label) { margin-top: 20px; font-size: .9rem; }
  .book-copy .outline-button { align-self: flex-start; }

  .research-heading { display: grid; grid-template-columns: .7fr 1.3fr; gap: 48px; margin-top: 74px; align-items: start; }
  .research-heading h3 { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 1.25rem; font-weight: 400; text-transform: uppercase; }
  .research-heading p { max-width: 650px; font-family: Georgia, 'Times New Roman', serif; font-size: 1rem; line-height: 1.6; }
  .research-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; margin-top: 34px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .research-grid > a { display: flex; min-height: 300px; flex-direction: column; padding: 22px; color: var(--ink); text-decoration: none; }
  .research-grid > a + a { border-left: 1px solid var(--line); }
  .research-grid h3 { margin-top: 44px; font-family: Georgia, 'Times New Roman', serif; font-size: 1.02rem; font-weight: 400; line-height: 1.35; }
  .research-grid p { margin-top: 14px; font-size: .84rem; line-height: 1.55; }
  .read-link { margin-top: auto; padding-top: 24px; font-size: .8rem; text-decoration: underline; }
  .more-link { margin-top: 18px !important; text-align: right; font-size: .82rem; }

  .personal-section { padding: 76px 0 84px; text-align: center; }
  .personal-section h2 { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 15px; margin: 30px auto 0; font-size: clamp(1.4rem, 3.5vw, 2.8rem); line-height: 1.45; letter-spacing: .04em; }
  .personal-section i { color: var(--muted); font-style: normal; }
  .cocker-trigger { border: 0; padding: 0; background: none; color: inherit; font: inherit; text-decoration: underline; text-underline-offset: 6px; cursor: pointer; }

  .closing-section { margin: 0 calc(50% - 50vw); padding: 78px max(24px, calc((100vw - 1180px) / 2)); background: var(--accent); color: #fff; text-align: center; }
  .closing-section .section-label { color: #c5ded6 !important; }
  .closing-section h2 { max-width: 900px; margin: 24px auto 0; font-size: clamp(1.8rem, 4vw, 3.5rem); line-height: 1.2; letter-spacing: .04em; }
  .closing-section > p:not(.section-label) { margin-top: 22px; color: #d9e8e3; font-family: Georgia, 'Times New Roman', serif; }
  .closing-section > div { display: flex; flex-wrap: wrap; justify-content: center; gap: 18px 28px; align-items: center; margin-top: 30px; }
  .light-button { margin-top: 0; border-color: #fff; color: #fff; }
  .light-button:hover { background: #fff; color: var(--accent); }
  .text-contact { color: #fff; font-size: .84rem; }

  .cocker-dialog { max-width: min(650px, calc(100vw - 32px)); max-height: calc(100vh - 32px); overflow: visible; border: 0; padding: 0; background: #000; }
  .cocker-dialog::backdrop { background: rgba(0, 0, 0, .76); }
  .cocker-dialog img { max-height: calc(100vh - 32px); object-fit: contain; }
  .cocker-close { position: absolute; top: 10px; right: 10px; width: 38px; height: 38px; border: 1px solid rgba(255,255,255,.55); border-radius: 50%; background: rgba(0,0,0,.55); color: #fff; font-size: 1.4rem; cursor: pointer; }

  @media (max-width: 820px) {
    .profile-header { padding-top: 46px; }
    .portrait-statement, .profile-columns, .book-feature { grid-template-columns: 1fr; }
    .portrait-statement figure { border-right: 0; border-bottom: 1px solid var(--line); padding-right: 0; }
    .statement { min-height: 300px; }
