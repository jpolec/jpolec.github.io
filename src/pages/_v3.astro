---
import SimpleLayout from '../layouts/SimpleLayout.astro';
import { profile } from '../data/profile';

const layers = [
  { name: 'Data', focus: 'Trust the inputs.', detail: 'Market and fundamental data, consistent contracts and validation at the boundary.', tags: 'Data pipelines · APIs · MCP' },
  { name: 'Research', focus: 'Make the result reproducible.', detail: 'Strategy research, backtest diagnostics and assumptions that can be inspected.', tags: 'Backtesting · Diagnostics · Validation' },
  { name: 'Portfolio', focus: 'Connect research to decisions.', detail: 'Portfolio state, approvals and execution context within a shared investment workflow.', tags: 'Portfolio state · Decision workflows' },
  { name: 'Risk', focus: 'Keep the constraints in view.', detail: 'Risk analytics and portfolio constraints as part of the decision process.', tags: 'Risk analytics · Portfolio constraints' },
  { name: 'AI', focus: 'Control what the agent can do.', detail: 'Scoped tools, explicit access and evidence-aware responses for financial workflows.', tags: 'OAuth · Scoped tools · Evidence' },
];
const projects = [
  { name: 'OneBook', area: 'Portfolio & decisions', detail: 'Research, portfolio state, risk and execution context in one workspace.', href: 'https://onebook.quantjourney.cloud/' },
  { name: 'Quant API / MCP', area: 'Data access', detail: 'Governed financial-data routes for applications and approved AI clients.', href: 'https://api.quantjourney.cloud/' },
  { name: 'Quant DataLake', area: 'Data infrastructure', detail: 'Market, fundamental and portfolio data for analytical workflows.', href: 'https://data.quantjourney.cloud/' },
  { name: 'Backtester', area: 'Systematic research', detail: 'Python-native strategy research, reproducible workflows and diagnostics.', href: 'https://backtester.quantjourney.cloud/' },
  { name: 'Agents', area: 'Applied AI', detail: 'Controlled financial tools with OAuth, scoped access and MCP.', href: 'https://agents.quantjourney.cloud/' },
];
const writing = [
  { title: 'Quant Interviews', type: 'The book', text: '1,600+ pages. 190+ problems. From mathematical foundations to Python, C++ and SQL.', href: 'https://quant-interviews.quantjourney.cloud' },
  { title: 'Quant Blog', type: 'The research', text: '200+ posts on quantitative research, markets, investment infrastructure and applied AI.', href: 'https://quantjourney.substack.com' },
  { title: 'GitHub', type: 'The code', text: 'Public repositories, working examples and release history. A closer look at the implementation.', href: 'https://github.com/jpolec' },
];
---

<SimpleLayout
  title="Jakub Połeć | Quantitative Systems & Engineering"
  description="Quantitative development, research systems and investment infrastructure. Jakub Połeć, founder of QuantJourney."
  canonical="https://jakubpolec.com/_v3/"
  noindex={true}
>
  <div class="v3">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="identity" href="#main" aria-label="Jakub Połeć, back to introduction">
        <span class="monogram" aria-hidden="true">JP<span>.</span></span>
        <span>{profile.name}</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#work">Work</a>
        <a href="#background">Background</a>
        <a href="#contact">Let’s talk <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Quant systems architect / Founder of QuantJourney</p>
          <h1 id="hero-title">Quantitative<br />thinking.<br /><span>Production<br />engineering.</span></h1>
          <p class="intro">I build the systems between a research idea and an investment decision.</p>
          <p class="hero-description">Data, backtesting, portfolio, risk and AI infrastructure for funds, family offices and investment-technology teams.</p>
          <div class="hero-actions">
            <a class="primary-link" href={profile.urls.email}>Discuss a project <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#work">Explore my work <span aria-hidden="true">↓</span></a>
          </div>
        </div>

        <aside class="stack" aria-labelledby="stack-title">
          <div class="stack-top"><span>Engineering perspective</span><span aria-hidden="true">[ 01 - 05 ]</span></div>
          <h2 id="stack-title">The whole stack.<br />The details within it.</h2>
          <p class="stack-instruction">Explore a layer</p>
          <div class="stack-layers">
            {layers.map((layer, index) => (
              <details name="engineering-layer" open={index === 0}>
                <summary>
                  <span class="layer-index" aria-hidden="true">0{index + 1}</span>
                  <span>{layer.name}</span>
                  <span class="layer-toggle" aria-hidden="true"></span>
                </summary>
                <div class="layer-content">
                  <h3>{layer.focus}</h3>
                  <p>{layer.detail}</p>
                  <p class="layer-tags">{layer.tags}</p>
                </div>
              </details>
            ))}
          </div>
          <p class="stack-footnote">Research integrity. Data quality. Operational control.</p>
        </aside>
      </section>

      <div class="context-strip wrap" aria-label="Professional background">
        <span>A path through</span>
        <p>High-energy physics <span aria-hidden="true">/</span> Microsoft <span aria-hidden="true">/</span> Oracle <span aria-hidden="true">/</span> QuantJourney</p>
      </div>

      <section id="work" class="work-section wrap section" aria-labelledby="work-title">
        <div class="section-heading">
          <p class="eyebrow"><span class="section-number">01</span> Selected work</p>
          <div class="heading-row">
            <h2 id="work-title">Systems you can<br />look into.</h2>
            <p>I build QuantJourney across the investment workflow. These products show where architecture meets implementation.</p>
          </div>
        </div>
        <div class="project-list">
          {projects.map((project) => (
            <a class="project" href={project.href} target="_blank" rel="noopener">
              <h3>{project.name}</h3>
              <span class="project-area">{project.area}</span>
              <p>{project.detail}</p>
              <span class="project-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
        <p class="platform-note">QuantJourney builds investment technology. It does not manage client assets or provide investment advice.</p>
      </section>

      <section id="background" class="background-section section" aria-labelledby="background-title">
        <div class="wrap background-grid">
          <figure>
            <img src="/jpbg.jpeg" alt="Jakub Połeć with Bill Gates during his Microsoft years" width="800" height="796" loading="lazy" decoding="async" />
            <figcaption>With Bill Gates, during my Microsoft years.</figcaption>
          </figure>
          <div class="background-copy">
            <p class="eyebrow"><span class="section-number">02</span> The person behind the systems</p>
            <h2 id="background-title">A physicist’s curiosity.<br />An engineer’s discipline.</h2>
            <p>My path runs from high-energy physics through Microsoft, technology entrepreneurship and Oracle to quantitative finance.</p>
            <p>At Oracle, I was {profile.career.oracleTitle}. Today, I bring that experience to quantitative development and the infrastructure investment teams depend on.</p>
            <p class="perspective">I care about the assumptions inside a model as much as the system around it.</p>
            <a class="text-link" href="https://linkedin.com/in/jakubpolec" target="_blank" rel="noopener">Professional background <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <section class="approach-section wrap section" aria-labelledby="approach-title">
        <div class="section-heading">
          <p class="eyebrow"><span class="section-number">03</span> How I work</p>
          <div class="heading-row">
            <h2 id="approach-title">Start with the<br />hard question.</h2>
            <p>A useful engagement starts with the decision your team needs to make and the constraint standing in its way.</p>
          </div>
        </div>
        <ol class="approach-list">
          <li><span class="step" aria-hidden="true">01 / Define</span><h3>What needs to work?</h3><p>Establish the research objective, users, data and operating constraints. Agree on what a useful result looks like.</p></li>
          <li><span class="step" aria-hidden="true">02 / Examine</span><h3>Where does it break?</h3><p>Inspect assumptions, data quality, backtest design and system boundaries. Make the trade-offs explicit.</p></li>
          <li><span class="step" aria-hidden="true">03 / Engineer</span><h3>How do we make it hold?</h3><p>Turn the findings into an implementation or a focused technical review, with validation and a clear handover.</p></li>
        </ol>
      </section>

      <section class="writing-section wrap section" aria-labelledby="writing-title">
        <div class="section-heading">
          <p class="eyebrow"><span class="section-number">04</span> Open notebook</p>
          <h2 id="writing-title">The thinking is public, too.</h2>
        </div>
        <div class="writing-grid">
          {writing.map((item) => (
            <a href={item.href} target="_blank" rel="noopener" class="writing-item">
              <span class="writing-type">{item.type}</span>
              <h3>{item.title}<span aria-hidden="true">↗</span></h3>
              <p>{item.text}</p>
            </a>
          ))}
        </div>
      </section>

      <section id="contact" class="contact-section" aria-labelledby="contact-title">
        <div class="wrap contact-grid">
          <div><p class="eyebrow">Have a hard problem?</p><h2 id="contact-title">Let’s get<br />into the details<span>.</span></h2></div>
          <div class="contact-copy">
            <p>I take on selected projects in quantitative development, data and platform architecture, research validation and technical due diligence.</p>
            <p>Tell me what you’re building, what you have and where you’re stuck.</p>
            <a class="contact-link" href={profile.urls.email}>Discuss your project <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer wrap">
      <p>{profile.name} <span aria-hidden="true">/</span> Quantitative systems &amp; engineering</p>
      <div><a href="https://linkedin.com/in/jakubpolec" target="_blank" rel="noopener">LinkedIn ↗</a><a href="https://github.com/jpolec" target="_blank" rel="noopener">GitHub ↗</a><a href="https://x.com/jakubpolec" target="_blank" rel="noopener">X ↗</a></div>
    </footer>
  </div>
</SimpleLayout>

<style>
  .v3 { --navy: #102c48; --body: #40556a; --quiet: #596c7e; --rule: #d8e1e9; --pink: #a30c78; --night: #0d2135; color: var(--navy); font-size: 1rem; line-height: 1.65; }
  .wrap { width: min(1180px, calc(100% - 80px)); margin-inline: auto; }
  h1, h2, h3, p, figure { margin: 0; }
  h1, h2, h3 { font-weight: 600; }
  h1, h2 { letter-spacing: -0.05em; line-height: 1.08; text-wrap: balance; }
  h2 { font-size: clamp(2rem, 3.6vw, 2.75rem); }
  h3 { font-size: 1rem; line-height: 1.65; }
  p { text-wrap: pretty; }
  a { text-decoration: none; }
  a, summary { -webkit-tap-highlight-color: transparent; }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--pink); outline-offset: 5px; }
  .skip-link { position: absolute; top: 8px; left: 12px; transform: translateY(-200%); z-index: 5; padding: 10px 16px; background: white; }
  .skip-link:focus { transform: none; }
  .site-header { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 22px; border-bottom: 1px solid var(--rule); }
  .identity { display: flex; align-items: center; gap: 18px; font-weight: 600; }
  .monogram { font-size: 1.75rem; font-weight: 700; line-height: 1; letter-spacing: -0.08em; }
  .monogram span { color: var(--pink); }
  nav { display: flex; align-items: center; gap: 30px; }
  nav a { display: inline-flex; gap: 16px; align-items: center; min-height: 44px; font-size: 0.875rem; }
  nav a:hover, .site-footer a:hover { color: var(--pink); }
  .hero { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.9fr); gap: clamp(40px, 6vw, 80px); align-items: center; padding-block: 68px; }
  .eyebrow { font-size: 0.8125rem; letter-spacing: 0.09em; text-transform: uppercase; font-weight: 500; line-height: 1.65; }
  .hero .eyebrow { max-width: 460px; margin-bottom: 24px; color: var(--quiet); }
  h1 { font-size: clamp(3.25rem, 5.5vw, 4.75rem); letter-spacing: -0.065em; line-height: 1.01; }
  h1 > span { color: var(--pink); }
  .intro { margin-top: 28px; max-width: 480px; }
  .hero-description { margin-top: 12px; max-width: 490px; color: var(--body); }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 16px 26px; margin-top: 28px; }
  .primary-link, .text-link { display: inline-flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 44px; }
  .primary-link { background: var(--navy); color: white; padding: 12px 20px; border-radius: 3px; }
  .primary-link:hover { background: var(--pink); }
  .text-link { text-decoration: underline; text-underline-offset: 6px; text-decoration-color: #aab8c5; }
  .text-link:hover { color: var(--pink); text-decoration-color: var(--pink); }
  .stack { color: #f2f6fa; background: var(--night); padding: 26px 28px 22px; border-top: 3px solid #b62c91; box-shadow: 12px 12px 0 #edf1f5; }
  .stack-top { display: flex; justify-content: space-between; gap: 16px; color: #a9bed1; font-size: 0.8125rem; }
  .stack h2 { font-size: 1.625rem; line-height: 1.25; letter-spacing: -0.035em; margin-top: 22px; }
  .stack-instruction { color: #a9bed1; font-size: 0.875rem; margin: 18px 0 8px; }
  .stack-layers details { border-top: 1px solid #35495b; }
  summary { display: flex; align-items: center; gap: 20px; min-height: 54px; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .layer-index { color: #a9bed1; font-size: 0.875rem; font-variant-numeric: tabular-nums; }
  .layer-toggle { position: relative; width: 14px; height: 14px; margin-left: auto; }
  .layer-toggle::before, .layer-toggle::after { content: ''; position: absolute; background: currentColor; top: 6px; left: 0; width: 14px; height: 1px; }
  .layer-toggle::after { transform: rotate(90deg); }
  details[open] .layer-toggle::after { transform: none; }
  details[open] summary, summary:hover { color: #f398d4; }
  .stack summary:focus-visible { outline-color: #f398d4; outline-offset: -2px; }
  .layer-content { padding: 0 0 22px 38px; }
  .layer-content h3 { margin-bottom: 8px; }
  .layer-content p { color: #b9cbdc; }
  .layer-content .layer-tags { margin-top: 14px; font-size: 0.8125rem; color: #f398d4; }
  .stack-footnote { border-top: 1px solid #35495b; padding-top: 16px; color: #a9bed1; font-size: 0.8125rem; }
  .context-strip { border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding-block: 22px; display: flex; align-items: baseline; justify-content: space-between; gap: 20px; }
  .context-strip > span { color: var(--quiet); font-size: 0.875rem; }
  .context-strip p { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 26px; font-weight: 500; }
  .context-strip p span { color: #9aa9b7; font-weight: 400; }
  .section { padding-block: 72px; scroll-margin-top: 24px; }
  .section-number { color: var(--pink); margin-right: 18px; letter-spacing: 0; }
  .section-heading { margin-bottom: 36px; }
  .section-heading > .eyebrow, .background-copy > .eyebrow { margin-bottom: 24px; }
  .heading-row { display: grid; grid-template-columns: 1fr 1fr; align-items: end; gap: 60px; }
  .heading-row > p { color: var(--body); max-width: 440px; }
  .project { display: grid; grid-template-columns: minmax(170px, 0.8fr) minmax(170px, 0.8fr) minmax(0, 1.75fr) auto; gap: 24px; padding: 24px 12px; margin-inline: -12px; border-top: 1px solid var(--rule); align-items: baseline; transition: background 160ms ease; }
  .project:last-child { border-bottom: 1px solid var(--rule); }
  .project-area { color: var(--quiet); }
  .project p { color: var(--body); }
  .project-arrow { color: var(--pink); }
  .project:hover { background: #f2f5f8; }
  .project:hover h3 { color: var(--pink); }
  .platform-note { margin-top: 22px; color: var(--quiet); }
  .background-section { background: #f2f5f8; border-block: 1px solid var(--rule); }
  .background-grid { display: grid; grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.3fr); gap: clamp(40px, 7vw, 100px); align-items: center; }
  figure { max-width: 380px; }
  figure img { width: 100%; height: auto; }
  figcaption { color: var(--quiet); margin-top: 12px; }
  .background-copy > p:not(.eyebrow) { margin-top: 20px; color: var(--body); }
  .background-copy > .perspective { color: var(--navy); border-left: 2px solid var(--pink); padding-left: 18px; }
  .background-copy .text-link { margin-top: 20px; }
  .approach-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px; list-style: none; padding: 0; margin: 0; }
  .approach-list li { border-top: 1px solid var(--rule); padding-top: 20px; }
  .step { color: var(--pink); font-size: 0.875rem; }
  .approach-list h3 { margin-top: 16px; }
  .approach-list p { margin-top: 12px; color: var(--body); }
  .writing-section { padding-top: 0; }
  .writing-section .section-heading { padding-top: 48px; border-top: 1px solid var(--rule); }
  .writing-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px; }
  .writing-type { color: var(--quiet); font-size: 0.875rem; }
  .writing-item h3 { display: flex; justify-content: space-between; gap: 16px; margin-top: 12px; }
  .writing-item h3 span { color: var(--pink); }
  .writing-item p { margin-top: 12px; color: var(--body); }
  .writing-item:hover h3 { color: var(--pink); text-decoration: underline; text-underline-offset: 5px; }
  .contact-section { background: var(--night); color: #f2f6fa; padding-block: 64px; scroll-margin-top: 0; }
  .contact-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 80px; align-items: center; }
  .contact-section .eyebrow { color: #b9cbdc; margin-bottom: 24px; }
  .contact-section h2 { font-size: clamp(2.75rem, 5vw, 4.25rem); }
  .contact-section h2 span { color: #f398d4; }
  .contact-copy p { color: #b9cbdc; }
  .contact-copy p + p { margin-top: 16px; }
  .contact-link { display: flex; justify-content: space-between; gap: 24px; padding-block: 18px; margin-top: 16px; border-bottom: 1px solid #8197ab; }
  .contact-link:hover { color: #f398d4; border-color: #f398d4; }
  .contact-link:focus-visible { outline-color: #f398d4; }
  .site-footer { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding-block: 24px; color: var(--quiet); font-size: 0.875rem; }
  .site-footer p span { margin-inline: 8px; }
  .site-footer > div { display: flex; gap: 24px; }
  .site-footer a { display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 1000px) {
    .wrap { width: calc(100% - 48px); }
    .hero { gap: 36px; grid-template-columns: 1.1fr 1fr; }
    h1 { font-size: clamp(3rem, 6vw, 4rem); }
    .stack { padding-inline: 22px; }
    .project { grid-template-columns: minmax(170px, 0.7fr) minmax(0, 1.3fr) auto; gap: 8px 24px; }
    .project h3 { grid-column: 1; grid-row: 1; }
    .project-area { grid-column: 1; grid-row: 2; font-size: 0.875rem; }
    .project p { grid-column: 2; grid-row: 1 / 3; }
    .project-arrow { grid-column: 3; grid-row: 1; }
    .context-strip { align-items: start; flex-direction: column; gap: 8px; }
    .context-strip p { gap: 8px 20px; }
    .background-grid { gap: 40px; }
    .heading-row, .contact-grid { gap: 40px; }
  }
  @media (max-width: 760px) {
    .wrap { width: calc(100% - 40px); }
    .site-header { padding-block: 14px; gap: 16px; }
    .identity { gap: 10px; }
    .identity > span:last-child { display: none; }
    nav { gap: 20px; }
    nav a { gap: 8px; }
    .hero { grid-template-columns: 1fr; gap: 40px; padding-block: 40px; }
    .hero .eyebrow { margin-bottom: 20px; }
    h1 { font-size: clamp(3rem, 11.7vw, 4.5rem); }
    .stack { box-shadow: 6px 6px 0 #edf1f5; }
    .hero-description, .intro { max-width: 550px; }
    .section { padding-block: 44px; }
    .heading-row, .background-grid, .contact-grid { grid-template-columns: 1fr; gap: 24px; }
    .section-heading { margin-bottom: 28px; }
    .heading-row > p { max-width: 550px; }
    .project { grid-template-columns: minmax(0, 1fr) auto; gap: 6px 16px; padding-block: 20px; }
    .project h3, .project-area, .project p { grid-column: 1; grid-row: auto; }
    .project p { margin-top: 6px; }
    .project-arrow { grid-column: 2; grid-row: 1; }
    .background-grid { gap: 32px; }
    .approach-list, .writing-grid { grid-template-columns: 1fr; gap: 28px; }
    .writing-section { padding-top: 0; }
    .writing-section .section-heading { padding-top: 40px; }
    .writing-item + .writing-item { padding-top: 24px; border-top: 1px solid var(--rule); }
    .contact-section { padding-block: 44px; }
    .site-footer { align-items: start; flex-direction: column; gap: 8px; }
  }
  @media (prefers-reduced-motion: reduce) { .project { transition: none; } }
</style>
