---
import { profile } from '../data/profile';
const email = profile.urls.email.replace('mailto:', '');
---

<div class="contact-links" aria-label="Contact and social profiles">
  <a class="email" href={profile.urls.email}>{email}</a>
  <a class="social" href="https://linkedin.com/in/jakubpolec" target="_blank" rel="noopener" aria-label="LinkedIn profile" title="LinkedIn">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M6.94 8.5A1.72 1.72 0 1 0 6.94 5.06a1.72 1.72 0 0 0 0 3.44ZM5.48 18.94h2.93V10H5.48v8.94ZM10.25 10v8.94h2.92v-4.42c0-1.17.22-2.3 1.67-2.3 1.43 0 1.45 1.34 1.45 2.38v4.34h2.93v-4.93c0-2.42-.52-4.28-3.35-4.28-1.36 0-2.27.74-2.64 1.45h-.04V10h-2.94Z" />
    </svg>
  </a>
  <a class="social" href="https://x.com/jakubpolec" target="_blank" rel="noopener" aria-label="X / Twitter profile" title="X / Twitter">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M18.9 2.25h3.68l-8.04 9.19L24 21.75h-7.41l-5.8-7.59-6.64 7.59H.46l8.6-9.83L0 2.25h7.6l5.24 6.93 6.06-6.93Zm-1.29 17.3h2.04L6.49 4.34H4.3L17.61 19.55Z" />
    </svg>
  </a>
</div>

<style>
  .contact-links { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; }
  a { color: inherit; font: inherit; }
  .email { display: inline-flex; align-items: center; min-height: 44px; text-underline-offset: 4px; overflow-wrap: anywhere; }
  .email:hover { text-decoration-thickness: 2px; }
  .social { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; }
  svg { width: 20px; height: 20px; fill: currentColor; }
  .social:hover { outline: 1px solid currentColor; outline-offset: -5px; }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
</style>
